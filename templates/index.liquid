{%- comment -%} Visually-hidden page heading keeps the homepage's h1 contract while its regions provide the visible composition. {%- endcomment -%}
<h1 class="sr-only">{{ shop.name }}</h1>

{%- liquid
  assign hero_image = images['monochrome-gallery-wall.png'] | default: collections.all.products.first.featured_image
  assign edit_image_one = images['monochrome-frame-desert.png']
  assign edit_image_two = images['monochrome-frame-island.png']
  assign craft_image = images['monochrome-frame-wall.png']
  assign edit_alt_one = 'home.edit.caption_one' | t
  assign edit_alt_two = 'home.edit.caption_two' | t
  assign craft_alt = 'home.craft.heading' | t
-%}

{%- comment -%} Hero: an exhibition title wall. The headline is set on paper above a full-bleed gallery photograph so type never fights the hung works. The image source and sizes are mirrored by the index preload in snippets/lcp-preload.liquid. {%- endcomment -%}
{% block 'container', class: 'w-full', attributes: 'aria-labelledby="home-hero-heading"' %}
  <div class="bg-surface-secondary">
  <div class="max-w-page mx-auto px-margin md:px-10 pt-12 md:pt-20 pb-10 md:pb-14 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
    <div class="md:col-span-8 flex flex-col items-start gap-6">
      {% block 'text', tag: 'p', variant: 'type-overline', class: 'inline-flex items-center gap-2 bg-accent text-surface px-3 py-1.5 tracking-[0.16em]' %}{{- 'home.hero.eyebrow' | t -}}{% endblock %}
      {% block 'text', tag: 'h2', variant: 'type-display', class: 'text-5xl md:text-(length:--type-heading-2xl-size) leading-[1.0] tracking-[-0.015em]', attributes: 'id="home-hero-heading"' %}
        {{- 'home.hero.heading' | t -}}
      {% endblock %}
    </div>
    <div class="md:col-span-4 flex flex-col items-start gap-6 md:pb-2">
      {% block 'text', variant: 'type-body-lg', class: 'max-w-sm text-on-surface-secondary' %}
        {{- 'home.hero.body' | t -}}
      {% endblock %}
      {% block 'button', url: routes.all_products_collection_url, variant: 'button-primary', class: 'rounded-button h-12 px-8 text-xs uppercase tracking-[0.14em]' %}
        {{- 'home.hero.cta' | t -}}
      {% endblock %}
    </div>
  </div>

  </div>

  <div class="relative w-full aspect-[4/5] sm:aspect-[16/9] lg:aspect-[21/9] overflow-hidden bg-surface-secondary">
    {%- assign hero_alt = 'home.hero.heading' | t -%}
    {% block 'image', image: hero_image, sizes: '100vw', attributes: 'loading="eager" fetchpriority="high"', alt: hero_alt, seed: 1, class: 'absolute inset-0' %}{% endblock %}
  </div>
{% endblock %}

{%- comment -%} Marquee: a terracotta band of studio promises that scrolls slowly; it holds still for reduced motion. The second copy is decorative so the loop is seamless. {%- endcomment -%}
{%- capture marquee_items -%}
  {%- assign marquee_keys = 'home.marquee.item_one,home.marquee.item_two,home.marquee.item_three,home.marquee.item_four' | split: ',' -%}
  {%- for marquee_key in marquee_keys -%}
    <li class="flex items-center gap-10 shrink-0 pe-10">
      {% block 'text', tag: 'span', variant: 'type-heading-md', class: 'italic whitespace-nowrap' %}{{- marquee_key | t -}}{% endblock %}
      <span class="inline-block size-2 rotate-45 bg-surface" aria-hidden="true"></span>
    </li>
  {%- endfor -%}
{%- endcapture -%}
{% block 'container', class: 'w-full overflow-hidden bg-accent text-surface border-y border-on-surface' %}
  <div class="flex w-max py-5 motion-safe:animate-marquee hover:[animation-play-state:paused]">
    <ul role="list" class="flex">{{ marquee_items }}</ul>
    <ul role="list" class="flex" aria-hidden="true">{{ marquee_items }}</ul>
  </div>
{% endblock %}

{%- comment -%} The edit: a sticky curatorial statement beside a staggered pair of framed works. {%- endcomment -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin md:px-10 py-16 md:py-28', attributes: 'aria-labelledby="home-edit-heading"' %}
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-10">
    <div class="md:col-span-5 md:sticky md:top-16 self-start flex flex-col gap-6 border-t-4 border-accent pt-6">
      {% block 'text', tag: 'h2', variant: 'type-heading-xl', class: 'text-4xl md:text-(length:--type-heading-xl-size) leading-[1.05]', attributes: 'id="home-edit-heading"' %}
        {{- 'home.edit.heading' | t -}}
      {% endblock %}

      {% block 'text', variant: 'type-body', class: 'max-w-[52ch] text-on-surface-secondary' %}
        {{- 'home.edit.body' | t -}}
      {% endblock %}

      <div>
        {% block 'link', url: routes.all_products_collection_url, class: 'uppercase tracking-[0.14em] text-xs' %}
          {{- 'home.edit.link' | t -}}
        {% endblock %}
      </div>
    </div>

    <div class="md:col-span-7 grid grid-cols-2 gap-4 md:gap-8">
      <figure class="flex flex-col gap-3">
        <div class="aspect-[3/4] overflow-hidden bg-surface-secondary">
          {% block 'image', image: edit_image_one, aspect_ratio: 'aspect-[3/4]', sizes: '(min-width: 768px) 30vw, 50vw', alt: edit_alt_one, seed: 2 %}{% endblock %}
        </div>
        <figcaption>
          {% block 'text', variant: 'type-body-sm', class: 'text-on-surface-secondary' %}{{- 'home.edit.caption_one' | t -}}{% endblock %}
        </figcaption>
      </figure>

      <figure class="flex flex-col gap-3 mt-20 md:mt-40">
        <div class="aspect-[3/4] overflow-hidden bg-surface-secondary">
          {% block 'image', image: edit_image_two, aspect_ratio: 'aspect-[3/4]', sizes: '(min-width: 768px) 30vw, 50vw', alt: edit_alt_two, seed: 3 %}{% endblock %}
        </div>
        <figcaption>
          {% block 'text', variant: 'type-body-sm', class: 'text-on-surface-secondary' %}{{- 'home.edit.caption_two' | t -}}{% endblock %}
        </figcaption>
      </figure>
    </div>
  </div>
{% endblock %}

{%- comment -%} The caller owns this collection source: the shell's settings cannot reach its pre-rendered body. Change this expression to swap the whole region; the shell's collection setting binds to it so the editor picker rewrites the handle here. {%- endcomment -%}
{%- liquid
  assign featured_collection = collection | default: collections.all
  assign featured_product_count = 4
  assign featured_url = featured_collection.url | default: routes.all_products_collection_url
  assign featured_product_sizes = '(min-width: 1280px) 290px, (min-width: 1024px) calc((100vw - 152px) / 4), calc((100vw - 48px) / 2)'
-%}

{%- comment -%} This bespoke shell owns its section/background/padding; do not double-wrap it in container. {%- endcomment -%}
{% block 'featured-collection', collection: featured_collection, class: 'bg-surface-secondary md:py-24' %}
  <div class="max-w-page mx-auto px-margin md:px-10">
    <div class="flex items-end justify-between gap-6 pb-6 mb-10 border-b border-on-surface/20">
      {% block 'text', tag: 'h2', variant: 'type-heading-xl', class: 'text-4xl md:text-(length:--type-heading-xl-size) leading-[1.05]' %}{{ 'home.featured.heading' | t }}{% endblock %}
      {% block 'link', url: featured_url, class: 'shrink-0 uppercase tracking-[0.14em] text-xs' %}{{ 'collections.view_all' | t }}{% endblock %}
    </div>

    <div class="contain-paint">
      {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
        <ul role="list" class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 md:gap-x-8 gap-y-12 stagger-fade-in">
          {% for product in featured_collection.products limit: featured_product_count %}
            <li>
              {%- # theme-check-disable-next-line UnknownFilter %}
              <s-view-event class="block" view-event-trigger="intersect" view-event-payload="{{ product | standard_event_data: 'view', context: 'collection' | escape }}">
                {%- assign card_variant = product.selected_or_first_available_variant -%}
                {% block 'card', block.name: 't:blocks.product_card', url: product.url, aria_label: product.title, border_radius: 'rounded-card' %}
                  <a href="{{ product.url | escape }}" class="relative block overflow-hidden rounded-[inherit] bg-surface motion-safe:transition-opacity hover:opacity-90" aria-label="{{ product.title | escape }}">
                    {% block 'image', fallback_image: product.featured_image, placeholder_kind: 'product', aspect_ratio: 'aspect-[3/4]', sizes: featured_product_sizes, attributes: 'loading="lazy"', alt: product.title, seed: forloop.index %}{% endblock %}
                    {% render 'product-badges', product: product, size: 'sm', class: 'absolute top-2 start-2 z-10 pointer-events-none' %}
                  </a>
                  <div class="flex flex-col gap-1 pt-1">
                    {% block 'text', variant: 'type-body', tag: 'h3', class: 'text-on-surface line-clamp-2' %}{{ product.title | escape }}{% endblock %}
                    {% block 'price', price: card_variant.price, compare_at_price: card_variant.compare_at_price, price_min: product.price_min, price_max: product.price_max, class: 'text-sm text-on-surface-secondary self-start group-[.text-center]/card:self-center group-[.text-end]/card:self-end' %}{% endblock %}
                  </div>
                {% endblock %}
              </s-view-event>
            </li>
          {% endfor %}
        </ul>
      {%- else -%}
        {%- comment -%} Placeholder cards remain selectable even before the store has products. {%- endcomment -%}
        <ul role="list" class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 md:gap-x-8 gap-y-12 stagger-fade-in">
          {% for placeholder_index in (1..featured_product_count) %}
            <li>
              {%- assign placeholder_title = 'product.placeholder_title' | t -%}
              {% block 'card', block.name: 't:blocks.product_card', url: routes.root_url, aria_label: placeholder_title, border_radius: 'rounded-card' %}
                <a href="{{ routes.root_url | escape }}" class="relative block overflow-hidden rounded-[inherit]" aria-label="{{ placeholder_title | escape }}">
                  {% block 'image', aspect_ratio: 'aspect-[3/4]', sizes: featured_product_sizes, alt: placeholder_title, seed: placeholder_index %}{% endblock %}
                </a>
                <div class="flex flex-col gap-1 pt-1">
                  {% block 'text', variant: 'type-body', tag: 'h3', class: 'text-on-surface line-clamp-2' %}{{ placeholder_title | escape }}{% endblock %}
                </div>
              {% endblock %}
            </li>
          {% endfor %}
        </ul>
      {%- endif -%}
    </div>
  </div>
{% endblock %}

{%- comment -%} Before/after: the same work bare and matted, sliding across a single gallery-scale frame. {%- endcomment -%}
{%- liquid
  assign compare_before = images['reckonings-without-mat.jpg']
  assign compare_after = images['reckonings-with-mat.jpg']
  assign compare_slider_label = 'accessibility.comparison_slider' | t
-%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin md:px-10 py-16 md:py-28', attributes: 'aria-labelledby="home-compare-heading"' %}
  <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 items-center">
    <div class="md:col-span-7 md:order-last">
      {% block 'before-after', class: 'aspect-square', before_image: compare_before, after_image: compare_after, sizes: '(min-width: 768px) 55vw, 100vw', slider_label: compare_slider_label %}
        <div class="pointer-events-none absolute inset-x-0 top-0 z-10 flex justify-between p-4 md:p-6">
          {% block 'text', tag: 'span', variant: 'type-overline', class: 'bg-surface text-on-surface px-3 py-2' %}{{- 'home.compare.before_label' | t -}}{% endblock %}
          {% block 'text', tag: 'span', variant: 'type-overline', class: 'bg-accent text-surface px-3 py-2' %}{{- 'home.compare.after_label' | t -}}{% endblock %}
        </div>
      {% endblock %}
    </div>

    <div class="md:col-span-5 flex flex-col gap-6 border-t border-on-surface pt-6">
      {% block 'text', tag: 'h2', variant: 'type-heading-xl', class: 'text-4xl md:text-(length:--type-heading-xl-size) leading-[1.05]', attributes: 'id="home-compare-heading"' %}
        {{- 'home.compare.heading' | t -}}
      {% endblock %}
      {% block 'text', variant: 'type-body', class: 'max-w-[48ch] text-on-surface-secondary' %}
        {{- 'home.compare.body' | t -}}
      {% endblock %}
      <div>
        {% block 'button', url: routes.all_products_collection_url, variant: 'button-outline', class: 'rounded-button h-12 px-8 text-xs uppercase tracking-[0.14em]' %}
          {{- 'home.compare.cta' | t -}}
        {% endblock %}
      </div>
    </div>
  </div>
{% endblock %}
<script type="module" src="{{ 's-before-after.js' | asset_url }}"></script>

{%- comment -%} Craft: the inverted ink band (footer carries the cobalt), stating paper, printing and editions plainly. {%- endcomment -%}
{% block 'container', class: 'bg-on-surface text-surface', attributes: 'aria-labelledby="home-craft-heading"' %}
  <div class="max-w-page mx-auto px-margin md:px-10 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-center">
    <div class="md:col-span-6 aspect-[4/3] overflow-hidden bg-surface-secondary">
      {% block 'image', image: craft_image, aspect_ratio: 'aspect-auto', sizes: '(min-width: 768px) 45vw, 100vw', alt: craft_alt, seed: 4, class: 'h-full' %}{% endblock %}
    </div>

    <div class="md:col-span-6 flex flex-col gap-10">
      {% block 'text', tag: 'h2', variant: 'type-heading-xl', class: 'text-4xl md:text-(length:--type-heading-xl-size) leading-[1.05]', attributes: 'id="home-craft-heading"' %}
        {{- 'home.craft.heading' | t -}}
      {% endblock %}

      <ul role="list" class="flex flex-col">
        <li class="grid grid-cols-1 sm:grid-cols-[12rem_1fr] gap-2 sm:gap-6 py-5 border-t border-surface/25">
          {% block 'text', tag: 'h3', variant: 'type-heading-sm' %}{{- 'home.craft.paper_title' | t -}}{% endblock %}
          {% block 'text', variant: 'type-body', class: 'opacity-80' %}{{- 'home.craft.paper_body' | t -}}{% endblock %}
        </li>
        <li class="grid grid-cols-1 sm:grid-cols-[12rem_1fr] gap-2 sm:gap-6 py-5 border-t border-surface/25">
          {% block 'text', tag: 'h3', variant: 'type-heading-sm' %}{{- 'home.craft.print_title' | t -}}{% endblock %}
          {% block 'text', variant: 'type-body', class: 'opacity-80' %}{{- 'home.craft.print_body' | t -}}{% endblock %}
        </li>
        <li class="grid grid-cols-1 sm:grid-cols-[12rem_1fr] gap-2 sm:gap-6 py-5 border-y border-surface/25">
          {% block 'text', tag: 'h3', variant: 'type-heading-sm' %}{{- 'home.craft.edition_title' | t -}}{% endblock %}
          {% block 'text', variant: 'type-body', class: 'opacity-80' %}{{- 'home.craft.edition_body' | t -}}{% endblock %}
        </li>
      </ul>

      <div>
        {% block 'button', url: routes.all_products_collection_url, variant: 'button-surface', class: 'rounded-button h-12 px-8 text-xs uppercase tracking-[0.14em]' %}
          {{- 'home.craft.cta' | t -}}
        {% endblock %}
      </div>
    </div>
  </div>
{% endblock %}
