{% layout none %}
{% liquid
  # used variables
  assign allcollection = ''
  assign currentcolor = ''
  assign discountrule = true

  # Get current product vendor
  assign productvendor = product.vendor

  # Get current product type
  assign producttype = product.type
  if product.type contains 'Niche'
    assign producttype = 'Niche'
  endif

  # price rule
  if product.price < product.compare_at_price
    assign discountrule = false
  endif

  # get current color
  for product_option in product.options_with_values
    if product_option.name contains 'Color' or product_option.name contains 'color' or product_option.name contains 'Colour' or product_option.name contains 'colour'
      for value in product_option.values
        assign currentcolor = value
      endfor
    endif
  endfor

  # get current product collections
  assign current_collections = product.collections | reject: 'title', 'All' | reject: 'title', 'Best Sellers'
  for coll in current_collections
    assign allcollection = allcollection | append: coll.handle | append: ','
  endfor

  # check product category
  assign allcollection = allcollection | append: 'womens-best-sellers,mens-best-sellers,all,'
  if productvendor contains 'Woman'
    assign allcollection = allcollection | append: 'womens-best-sellers,all,'
  elsif productvendor contains 'Man'
    assign allcollection = allcollection | append: 'mens-best-sellers,all,'
  endif

  assign allcollection = allcollection | split: ',' | compact | uniq | join: ','
  assign finalallcollection = allcollection | split: ','

  # all valid collections loop
  assign count = 0 | times: 1

  # priority variables
  assign priority1 = ''
  assign priority2_1 = ''
  assign priority2_2 = ''
  assign priority3 = ''

  assign break_loop = false
  for collectionHandle in finalallcollection
    assign current_collection = collections[collectionHandle]
    paginate current_collection.products by 250
      # sort with availability
      assign sorted_products = current_collection.products | sort: 'created_at' | where: 'available', true

      # get valid product type
      assign item_type_products1 = sorted_products | where: 'type', 'Mass Market'
      if product.type contains 'Niche'
        assign item_type_products1 = sorted_products
      endif

      for item in item_type_products1
        # each product item price logic
        if item.price < item.compare_at_price and discountrule == true
          assign salePercent = item.compare_at_price_max | minus: item.price | times: 100.0 | divided_by: item.compare_at_price_max | times: 100 | money_without_currency
          assign checkMultipleoffive = salePercent | modulo: 5 | round
          assign NewsalePercent = salePercent | round
          if checkMultipleoffive > 0
            assign NewsalePercent = salePercent | divided_by: 5.00 | round | times: 5
          endif
        endif

        # check each product item discount rule
        assign check25Percent = true
        if discountrule
          if NewsalePercent <= 25
            assign check25Percent = true
          else
            assign check25Percent = false
          endif
        endif

        if item.type contains producttype and item.handle != product.handle and check25Percent == true
          # get each product item current color
          for product_option in item.options_with_values
            if product_option.name contains 'Color' or product_option.name contains 'color' or product_option.name contains 'Colour' or product_option.name contains 'colour'
              for value in product_option.values
                assign thisitemcolor = value
              endfor
            endif
          endfor

          # get each product item all collections
          assign item_allcollections = ''
          for all_coll in item.collections
            assign item_allcollections = item_allcollections | append: all_coll.title | append: ','
          endfor
          assign final_item_allcollections = item_allcollections | split: ','

          if item.vendor == productvendor and thisitemcolor == currentcolor
            unless priority1 contains item.id
              assign priority1 = priority1 | append: item.id | append: ','
              assign count = count | plus: 1
            endunless
          elsif item.vendor == productvendor
            if final_item_allcollections contains 'Best Sellers'
              unless priority2_1 contains item.id
                assign priority2_1 = priority2_1 | append: item.id | append: ','
                assign count = count | plus: 1
              endunless
            else
              unless priority2_2 contains item.id
                assign priority2_2 = priority2_2 | append: item.id | append: ','
                assign count = count | plus: 1
              endunless
            endif
          elsif current_collection.title contains 'Best Sellers'
            unless priority3 contains item.id
              assign priority3 = priority3 | append: item.id | append: ','
              assign count = count | plus: 1
            endunless
          endif
        endif

        if count == 48
          assign break_loop = true
          break
        endif
      endfor
    endpaginate

    if break_loop
      break
    endif
  endfor

  assign final_priority = priority1 | append: priority2_1 | append: priority2_2 | append: priority3 | split: ','
  assign all_final_priority = final_priority | compact | join: ','

  echo all_final_priority
%}

