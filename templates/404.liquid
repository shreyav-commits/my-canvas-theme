{%- liquid
  assign suggestion_collection = collections['custom-frame-collections']
  if suggestion_collection.products_count == 0
    assign suggestion_collection = collections.all
  endif
  assign suggestion_sizes = '(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 45vw'
-%}

{% comment %} Gallery-style 404: the "0" is an empty frame swinging on its nail, with a sorry note and a few pieces to keep browsing. {% endcomment %}
{% block 'container', class: 'box-border w-[min(100%,1500px)] mx-auto [padding-inline-start:max(clamp(24px,4.5vw,72px),var(--safe-area-inset-inline-start))] [padding-inline-end:max(clamp(24px,4.5vw,72px),var(--safe-area-inset-inline-end))]', attributes: 'aria-labelledby="not-found-title"' %}
  <div class="grid gap-12 py-[clamp(56px,9svh,128px)] md:grid-cols-[1.1fr_1fr] md:items-center md:gap-16">
    {%- comment -%} 4 [frame] 4 {%- endcomment -%}
    <div class="flex items-center justify-center gap-[clamp(8px,2vw,24px)] font-heading font-light leading-none text-on-surface text-[clamp(7rem,22vw,15rem)] md:order-2" aria-hidden="true">
      <span>4</span>
      <span class="relative inline-flex flex-col items-center">
        <span class="block size-2.5 rounded-full bg-on-surface"></span>
        <span class="relative -mt-1 block origin-top motion-safe:animate-swing">
          <svg class="mx-auto block h-[0.18em] w-[0.5em] text-on-surface/60" viewBox="0 0 100 40" fill="none" stroke="currentColor" stroke-width="2"><path d="M50 2 L4 38 M50 2 L96 38"/></svg>
          <span class="flex aspect-[3/4] w-[0.62em] items-center justify-center border-[0.06em] border-on-surface bg-surface-secondary p-[0.05em] shadow-xl">
            <span class="flex size-full items-center justify-center border border-on-surface/20 bg-surface">
              <span class="inline-block text-[0.26em] motion-safe:animate-wobble">🙈</span>
            </span>
          </span>
        </span>
      </span>
      <span>4</span>
    </div>

    <div class="min-w-0 md:order-1">
      <span class="inline-flex items-center gap-2 bg-accent px-3 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-surface">
        {{- '404.sorry_badge' | t -}}
      </span>
      {% block 'text', tag: 'h1', variant: 'type-display', class: 'mt-6 max-w-[16ch] text-on-surface leading-[1.05] tracking-[-0.01em]', attributes: 'id="not-found-title"' %}{{ '404.heading' | t }}{% endblock %}
      <span class="mt-6 block h-px w-10 bg-on-surface/40" aria-hidden="true"></span>
      {% block 'text', variant: 'type-body', class: 'mt-6 max-w-[44ch] text-on-surface-secondary' %}{{ '404.body' | t }}{% endblock %}

      <div class="mt-8 flex flex-wrap gap-3">
        {% block 'button', url: routes.all_products_collection_url, variant: 'button-primary', class: 'rounded-button min-h-[50px] px-6 py-3 text-xs uppercase tracking-[0.14em] gap-3' %}
          <span>{{ '404.back_to_shopping' | t }}</span>
          <span class="inline-flex size-4 shrink-0 items-center justify-center rtl:-scale-x-100" aria-hidden="true">{{- 'icon-arrow-right.svg' | inline_asset_content -}}</span>
        {% endblock %}
        {% block 'button', url: routes.root_url, variant: 'button-outline', class: 'rounded-button min-h-[50px] px-6 py-3 text-xs uppercase tracking-[0.14em] border' %}{{ '404.back_home' | t }}{% endblock %}
      </div>

      <form action="{{ routes.search_url }}" method="get" role="search" class="mt-8 flex max-w-md items-center border-b border-on-surface/40 focus-within:border-on-surface">
        <label for="not-found-search" class="sr-only">{{ '404.search_label' | t }}</label>
        <input id="not-found-search" type="search" name="q" placeholder="{{ '404.search_placeholder' | t }}" class="min-w-0 flex-1 border-0 bg-transparent px-0 py-3 text-sm text-on-surface placeholder:text-on-surface-secondary focus:outline-none focus:ring-0">
        <button type="submit" class="shrink-0 py-3 ps-4 text-xs font-bold uppercase tracking-[0.14em] text-on-surface">{{ '404.search_button' | t }}</button>
      </form>
    </div>
  </div>

  {%- if suggestion_collection.products_count > 0 -%}
    <div class="border-t border-on-surface/15 pt-10 pb-[clamp(56px,8svh,112px)]">
      {% block 'text', tag: 'h2', variant: 'type-heading-md', class: 'text-on-surface' %}{{ '404.suggestions_heading' | t }}{% endblock %}
      <ul role="list" class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4">
        {%- for product in suggestion_collection.products limit: 4 -%}
          {%- assign card_variant = product.selected_or_first_available_variant -%}
          <li>
            <a href="{{ product.url | escape }}" class="group relative block overflow-hidden bg-surface-secondary" aria-label="{{ product.title | escape }}">
              {% block 'image', fallback_image: product.featured_image, placeholder_kind: 'product', aspect_ratio: 'aspect-[3/4]', sizes: suggestion_sizes, attributes: 'loading="lazy"', alt: product.title, class: 'motion-safe:transition-transform motion-safe:duration-500 group-hover:scale-[1.03]' %}{% endblock %}
              {% render 'product-badges', product: product, size: 'sm', class: 'absolute top-2 start-2 z-10 pointer-events-none' %}
            </a>
            <div class="mt-3 flex flex-col gap-1">
              {% block 'text', variant: 'type-body', tag: 'h3', class: 'text-on-surface line-clamp-2' %}{{ product.title | escape }}{% endblock %}
              {% block 'price', price: card_variant.price, compare_at_price: card_variant.compare_at_price, price_min: product.price_min, price_max: product.price_max, class: 'text-sm text-on-surface-secondary' %}{% endblock %}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
{% endblock %}
