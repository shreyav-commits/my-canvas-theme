{%- comment -%} Contact page: ink panel with the pitch and contact details beside an underline-style form with floating labels and topic chips. {%- endcomment -%}
{%- liquid
  assign name_error = ''
  assign email_error = ''
  assign phone_error = ''
  assign body_error = ''

  assign field_class = 'peer block w-full bg-transparent border-0 border-b border-on-surface/30 rounded-none px-0 pt-7 pb-2 text-base text-on-surface placeholder:text-transparent hover:border-on-surface/60 focus:border-on-surface focus-visible:outline-none aria-invalid:border-critical motion-safe:transition-colors'
  assign label_class = 'pointer-events-none absolute start-0 top-7 text-base text-on-surface-secondary origin-[0] motion-safe:transition-all motion-safe:duration-200 peer-focus:top-1 peer-focus:text-xs peer-focus:uppercase peer-focus:tracking-[0.14em] peer-focus:text-on-surface peer-[:not(:placeholder-shown)]:top-1 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:uppercase peer-[:not(:placeholder-shown)]:tracking-[0.14em]'
  assign topics = 'contact.topic_general,contact.topic_order,contact.topic_framing,contact.topic_commission' | split: ','
-%}

{% block 'container', class: 'w-full max-w-page mx-auto px-margin md:px-10 py-10 md:py-16' %}
  <div class="grid grid-cols-1 lg:grid-cols-12 border border-on-surface/15">
    {%- comment -%} Pitch panel {%- endcomment -%}
    <div class="lg:col-span-5 bg-interactive text-interactive-text p-8 md:p-12 lg:p-14 flex flex-col justify-between gap-12">
      <div class="flex flex-col gap-6">
        {% block 'text', tag: 'p', variant: 'type-overline', class: 'tracking-[0.18em] opacity-70' %}{{ page.title | escape }}{% endblock %}
        {% block 'text', tag: 'h1', variant: 'type-display', class: 'text-[2.5rem] md:text-(length:--type-heading-2xl-size) leading-[1.05] tracking-[-0.015em]' %}{{- 'contact.heading' | t -}}{% endblock %}
        {% block 'text', variant: 'type-body', class: 'opacity-80 max-w-[40ch]' %}{{- 'contact.intro' | t -}}{% endblock %}
        {%- if page.content != blank -%}
          <div class="richtext opacity-80 max-w-[44ch] [&_a]:text-interactive-text">{{ page.content }}</div>
        {%- endif -%}
      </div>

      <dl class="flex flex-col border-t border-interactive-text/20">
        {%- if shop.email != blank -%}
          <div class="flex items-baseline justify-between gap-6 py-4 border-b border-interactive-text/20">
            <dt class="text-xs uppercase tracking-[0.14em] opacity-60">{{ 'contact.email_us' | t }}</dt>
            <dd class="text-end"><a href="mailto:{{ shop.email }}" class="text-interactive-text no-underline hover:opacity-70 motion-safe:transition-opacity break-all">{{ shop.email }}</a></dd>
          </div>
        {%- endif -%}
        <div class="flex items-baseline justify-between gap-6 py-4 border-b border-interactive-text/20">
          <dt class="text-xs uppercase tracking-[0.14em] opacity-60">{{ 'contact.response_label' | t }}</dt>
          <dd class="text-end">{{ 'contact.response_value' | t }}</dd>
        </div>
        {%- if shop.address.city != blank -%}
          <div class="flex items-baseline justify-between gap-6 py-4 border-b border-interactive-text/20">
            <dt class="text-xs uppercase tracking-[0.14em] opacity-60">{{ 'contact.studio_label' | t }}</dt>
            <dd class="text-end">{{ shop.address.city }}{% if shop.address.country != blank %}, {{ shop.address.country }}{% endif %}</dd>
          </div>
        {%- endif -%}
      </dl>
    </div>

    {%- comment -%} Form panel {%- endcomment -%}
    <div class="lg:col-span-7 bg-surface p-8 md:p-12 lg:p-14">
      {% form 'contact', class: 'flex flex-col gap-8' %}
        {%- if form.posted_successfully? -%}
          <div role="status" tabindex="-1" autofocus class="flex items-start gap-4 border border-on-surface/15 bg-surface-secondary p-6">
            <span class="inline-flex items-center justify-center size-10 shrink-0 bg-interactive text-interactive-text" aria-hidden="true"><span class="inline-flex size-4">{{- 'icon-check.svg' | inline_asset_content -}}</span></span>
            <div class="flex flex-col gap-1">
              <p class="font-heading text-2xl leading-tight">{{ 'contact.success_heading' | t }}</p>
              <p class="type-body text-on-surface-secondary">{{ 'contact.success' | t }}</p>
            </div>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div role="alert" tabindex="-1" autofocus class="border-s-4 border-s-critical bg-critical/10 p-4 text-on-surface">
            <p class="type-body font-medium mb-1">{{ 'forms.form_errors_title' | t }}</p>
            <ul class="list-disc ps-4 text-sm">
              {% for field in form.errors %}
                <li>{{ form.errors.translated_fields[field] | escape }} {{ form.errors.messages[field] | escape }}</li>
              {% endfor %}
            </ul>
          </div>

          {%- for field in form.errors -%}
            {%- capture field_error_message -%}{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}{%- endcapture -%}
            {%- case field -%}
              {%- when 'name' -%}
                {%- assign name_error = field_error_message -%}
              {%- when 'email' -%}
                {%- assign email_error = field_error_message -%}
              {%- when 'phone' -%}
                {%- assign phone_error = field_error_message -%}
              {%- when 'body' -%}
                {%- assign body_error = field_error_message -%}
            {%- endcase -%}
          {%- endfor -%}
        {%- endif -%}

        {% block 'text', tag: 'h2', variant: 'type-heading-lg' %}{{- 'contact.form_heading' | t -}}{% endblock %}

        <fieldset class="flex flex-col gap-3 border-0 p-0 m-0">
          <legend class="mb-3 text-xs uppercase tracking-[0.14em] text-on-surface-secondary">{{ 'contact.topic_label' | t }}</legend>
          <div class="flex flex-wrap gap-2">
            {%- for topic_key in topics -%}
              {%- assign topic_value = topic_key | t -%}
              <label class="cursor-pointer">
                <input type="radio" name="contact[Topic]" value="{{ topic_value | escape }}" class="peer sr-only"{% if form.topic == topic_value or forloop.first and form.topic == blank %} checked{% endif %}>
                <span class="inline-flex items-center h-10 px-4 border border-on-surface/30 text-sm text-on-surface hover:border-on-surface peer-checked:bg-interactive peer-checked:text-interactive-text peer-checked:border-interactive peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-on-surface motion-safe:transition-colors">{{ topic_value }}</span>
              </label>
            {%- endfor -%}
          </div>
        </fieldset>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
          <div class="relative">
            <input type="text" id="contact-name" name="contact[name]" placeholder=" " class="{{ field_class }}" value="{{ form.name | default: customer.name | escape }}" autocomplete="name" required aria-required="true"{% if name_error != blank %} aria-invalid="true" aria-describedby="contact-name-error"{% endif %}>
            <label for="contact-name" class="{{ label_class }}">{{- 'contact.name' | t -}}<span aria-hidden="true"> *</span><span class="sr-only"> ({{ 'forms.required' | t }})</span></label>
            {%- if name_error != blank -%}<p id="contact-name-error" class="mt-2 text-sm text-critical">{{ name_error | escape }}</p>{%- endif -%}
          </div>

          <div class="relative">
            <input type="email" id="contact-email" name="contact[email]" placeholder=" " class="{{ field_class }}" value="{{ form.email | default: customer.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required aria-required="true"{% if email_error != blank %} aria-invalid="true" aria-describedby="contact-email-error"{% endif %}>
            <label for="contact-email" class="{{ label_class }}">{{- 'contact.email' | t -}}<span aria-hidden="true"> *</span><span class="sr-only"> ({{ 'forms.required' | t }})</span></label>
            {%- if email_error != blank -%}<p id="contact-email-error" class="mt-2 text-sm text-critical">{{ email_error | escape }}</p>{%- endif -%}
          </div>

          <div class="relative md:col-span-2">
            <input type="tel" id="contact-phone" name="contact[phone]" placeholder=" " class="{{ field_class }}" value="{{ form.phone | escape }}" autocomplete="tel"{% if phone_error != blank %} aria-invalid="true" aria-describedby="contact-phone-error"{% endif %}>
            <label for="contact-phone" class="{{ label_class }}">{{ 'contact.phone' | t }}</label>
            {%- if phone_error != blank -%}<p id="contact-phone-error" class="mt-2 text-sm text-critical">{{ phone_error | escape }}</p>{%- endif -%}
          </div>

          <div class="relative md:col-span-2">
            <textarea id="contact-message" name="contact[body]" placeholder=" " rows="5" class="{{ field_class }} resize-y min-h-36" required aria-required="true"{% if body_error != blank %} aria-invalid="true" aria-describedby="contact-message-error"{% endif %}>{{ form.body | escape }}</textarea>
            <label for="contact-message" class="{{ label_class }}">{{- 'contact.message' | t -}}<span aria-hidden="true"> *</span><span class="sr-only"> ({{ 'forms.required' | t }})</span></label>
            {%- if body_error != blank -%}<p id="contact-message-error" class="mt-2 text-sm text-critical">{{ body_error | escape }}</p>{%- endif -%}
          </div>
        </div>

        <div>
          {% block 'button', type: 'submit', class: 'group/send inline-flex items-center gap-3 h-14 px-10 rounded-button text-xs font-medium uppercase tracking-[0.14em] w-full sm:w-auto justify-center' %}
            {{- 'contact.submit' | t -}}
            <span class="inline-flex size-4 motion-safe:transition-transform group-hover/send:translate-x-1 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-arrow-right.svg' | inline_asset_content -}}</span>
          {% endblock %}
        </div>
      {% endform %}
    </div>
  </div>
{% endblock %}
