{% block 'container' %}
  {%- # theme-check-disable-next-line UnknownFilter %}
  <s-view-event class="block py-12" view-event-trigger="connect" view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <s-collection-view id="collection-view" class="block group/view" data-view="grid" data-cart-update-url="{{ routes.cart_update_url }}">
  {%- liquid
    assign per_page_options = '12,24,36,48' | split: ','
    assign per_page = 24
    assign stored_per_page = cart.attributes['_per_page'] | default: '' | strip
    if per_page_options contains stored_per_page
      assign per_page = stored_per_page | plus: 0
    endif
  -%}
  <div class="max-w-page mx-auto px-margin">
  <div class="mb-8 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="min-w-0">
      {% block 'text', tag: 'h1', variant: 'type-heading-xl', class: 'mb-2' %}{{ collection.title | escape }}{% endblock %}
      {% if collection.description != blank %}
        <div class="richtext text-on-surface-secondary">{{ collection.description }}</div>
      {% endif %}
    </div>

    {%- comment -%} Display controls live outside the live filter form so their changes never trigger a filter fetch. {%- endcomment -%}
    <div class="flex items-center gap-6 shrink-0">
      <div class="flex items-center gap-2">
        <label for="collection-per-page" class="text-xs uppercase tracking-[0.14em] text-on-surface-secondary whitespace-nowrap">{{ 'collections.per_page_label' | t }}</label>
        <div class="relative">
          <select id="collection-per-page" data-per-page class="appearance-none cursor-pointer h-11 border border-on-surface/30 rounded-input bg-surface ps-3 pe-9 text-sm text-on-surface disabled:opacity-50 hover:border-on-surface motion-safe:transition-colors">
            {%- for option in per_page_options -%}
              {%- assign option_number = option | plus: 0 -%}
              <option value="{{ option }}"{% if option_number == per_page %} selected{% endif %}>{{ 'collections.per_page_option' | t: count: option_number }}</option>
            {%- endfor -%}
          </select>
          <span class="pointer-events-none absolute inset-y-0 end-3 flex items-center size-4 my-auto" aria-hidden="true">{{- 'icon-chevron-down.svg' | inline_asset_content -}}</span>
        </div>
      </div>

      <div class="flex items-center" role="group" aria-label="{{ 'collections.view_label' | t | escape }}">
        <button type="button" commandfor="collection-view" command="--view-grid" data-view-option="grid" aria-pressed="true" aria-label="{{ 'collections.view_grid' | t | escape }}" class="inline-flex items-center justify-center size-11 border border-on-surface/30 cursor-pointer text-on-surface hover:border-on-surface aria-pressed:bg-interactive aria-pressed:text-interactive-text aria-pressed:border-interactive motion-safe:transition-colors">
          <span class="inline-flex size-4" aria-hidden="true">{{- 'icon-grid.svg' | inline_asset_content -}}</span>
        </button>
        <button type="button" commandfor="collection-view" command="--view-list" data-view-option="list" aria-pressed="false" aria-label="{{ 'collections.view_list' | t | escape }}" class="inline-flex items-center justify-center size-11 -ms-px border border-on-surface/30 cursor-pointer text-on-surface hover:border-on-surface aria-pressed:bg-interactive aria-pressed:text-interactive-text aria-pressed:border-interactive motion-safe:transition-colors">
          <span class="inline-flex size-4" aria-hidden="true">{{- 'icon-list.svg' | inline_asset_content -}}</span>
        </button>
      </div>
    </div>
  </div>
</div>

<s-live-form class="block" partial="collection-count,collection-chips,collection-filters,collection-grid" debounce="300" data-collection-id="{{ collection.id }}" data-collection-handle="{{ collection.handle | escape }}" data-updated-message="{{ 'accessibility.results_updated' | t }}" data-error-message="{{ 'accessibility.update_error' | t }}">
  <form action="{{ collection.url }}" method="get" role="search" aria-label="{{ 'collections.filter' | t }}">
    {% capture collection_filter_trigger %}
      {% block 'button', commandfor: 'collection-filter-drawer', command: 'show-modal', variant: 'button-outline', class: 'h-11 px-4 text-sm rounded-button' %}{{ 'collections.filter' | t }}{% endblock %}
    {% endcapture %}
    {% capture collection_toolbar_submit %}
      {% block 'button', type: 'submit', class: 'h-11 px-4 rounded-button' %}{{ 'collections.show_results' | t }}{% endblock %}
    {% endcapture %}

    {% capture collection_filter_close_button %}
      {%- capture close_attrs -%}aria-label="{{ 'general.close' | t }}"{%- endcapture -%}
      {% block 'button', commandfor: 'collection-filter-drawer', command: 'close', variant: 'button-ghost', class: 'size-touch-target rounded', autofocus: true, attributes: close_attrs %}<span class="inline-flex items-center justify-center size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
    {% endcapture %}
    {% capture collection_results_button %}
      {% block 'button', commandfor: 'collection-filter-drawer', command: 'close', variant: 'button-primary', class: 'h-11 w-full rounded-button' %}{{ 'collections.show_results' | t }}{% endblock %}
    {% endcapture %}
    {% capture collection_drawer_submit %}
      {% block 'button', type: 'submit', class: 'h-11 w-full rounded-button' %}{{ 'collections.show_results' | t }}{% endblock %}
    {% endcapture %}
    {% render 'filters', page_type: 'collection', resource: collection, drawer_id: 'collection-filter-drawer', filter_trigger: collection_filter_trigger, toolbar_submit: collection_toolbar_submit, close_button: collection_filter_close_button, show_results_button: collection_results_button, drawer_submit: collection_drawer_submit %}

    {% partial 'collection-grid' %}
{% paginate collection.products by per_page %}
  {% if collection.products.size > 0 %}
    <h2 class="sr-only">{{ 'collections.products_heading' | t }}</h2>
    {%- comment -%} Account for the 1280px page cap, 16/40px gutters, and 4px column gaps; mirror in snippets/lcp-preload.liquid. {%- endcomment -%}
    {%- assign product_sizes = '(min-width: 1280px) 297px, (min-width: 1024px) calc((100vw - 92px) / 4), (min-width: 768px) calc((100vw - 84px) / 2), calc(100vw - 32px)' -%}
    <div class="w-full max-w-page mx-auto px-margin contain-paint">
      <ul id="product-grid" role="list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-1 gap-y-10 mb-8 stagger-fade-in group-data-[view=list]/view:grid-cols-1 group-data-[view=list]/view:gap-y-0 group-data-[view=list]/view:border-t group-data-[view=list]/view:border-on-surface/15">
        {% for product in collection.products %}
          <li class="group-data-[view=list]/view:border-b group-data-[view=list]/view:border-on-surface/15 group-data-[view=list]/view:py-6">
            {%- comment -%} The four-slot eager threshold matches one large-screen row; only slot one competes at high priority for LCP, while the remaining eager row stays low priority. {%- endcomment -%}
            {%- if forloop.index <= 4 -%}{%- assign lazy_load = false -%}{%- else -%}{%- assign lazy_load = true -%}{%- endif -%}
            {%- if forloop.first -%}{%- assign fetch_priority = 'high' -%}{%- elsif forloop.index <= 4 -%}{%- assign fetch_priority = 'low' -%}{%- else -%}{%- assign fetch_priority = 'auto' -%}{%- endif -%}
            {%- # theme-check-disable-next-line UnknownFilter %}
            <s-view-event class="block" view-event-trigger="intersect" view-event-payload="{{ product | standard_event_data: 'view', context: 'collection' | escape }}">
              {%- liquid
                assign card_variant = product.selected_or_first_available_variant
                if lazy_load
                  assign card_loading = 'lazy'
                else
                  assign card_loading = 'eager'
                endif
                assign card_image_attributes = 'loading="' | append: card_loading | append: '" fetchpriority="' | append: fetch_priority | append: '"'
              -%}
              {% block 'card', block.name: 't:blocks.product_card', url: product.url, aria_label: product.title, border_radius: 'rounded-card', class: 'group-data-[view=list]/view:flex-row group-data-[view=list]/view:items-center group-data-[view=list]/view:gap-6 md:group-data-[view=list]/view:gap-10' %}
                <a href="{{ product.url | escape }}" class="relative block overflow-hidden rounded-[inherit] group-data-[view=list]/view:w-28 md:group-data-[view=list]/view:w-48 group-data-[view=list]/view:shrink-0" aria-label="{{ product.title | escape }}">
                  {% block 'image', fallback_image: product.featured_image, placeholder_kind: 'product', aspect_ratio: 'aspect-square', sizes: product_sizes, attributes: card_image_attributes, alt: product.title, seed: forloop.index %}{% endblock %}
                  {% render 'product-badges', product: product, size: 'sm', class: 'absolute top-2 start-2 z-10 pointer-events-none' %}
                </a>
                <div class="flex flex-col gap-0.5 min-w-0 group-data-[view=list]/view:flex-1 group-data-[view=list]/view:gap-2">
                  {% block 'text', variant: 'type-body-sm', tag: 'h3', class: 'font-medium text-on-surface line-clamp-2' %}{{ product.title | escape }}{% endblock %}
                  {%- comment -%} Text alignment inherits from the shell; the flex price needs its own logical self alignment. {%- endcomment -%}
                  {% block 'price', price: card_variant.price, compare_at_price: card_variant.compare_at_price, price_min: product.price_min, price_max: product.price_max, class: 'text-sm font-medium self-start group-[.text-center]/card:self-center group-[.text-end]/card:self-end' %}{% endblock %}
                  {%- if product.description != blank -%}
                    {% block 'text', variant: 'type-body-sm', class: 'hidden group-data-[view=list]/view:md:block text-on-surface-secondary max-w-prose line-clamp-2' %}{{ product.description | strip_html | truncatewords: 30 }}{% endblock %}
                  {%- endif -%}
                </div>
              {% endblock %}
            </s-view-event>
          </li>
        {% endfor %}
      </ul>
    </div>
    <div class="max-w-page mx-auto px-margin">
      {% block 'pagination', paginate: paginate, target: '#product-grid' %}{% endblock %}
    </div>
  {% else %}
    {% block 'text', variant: 'type-body', class: 'text-on-surface-secondary py-12 text-center max-w-page mx-auto px-margin' %}{{ 'collections.no_products' | t }}{% endblock %}
  {% endif %}
{% endpaginate %}
    {% endpartial %}
  </form>
</s-live-form>
  </s-collection-view>
</s-view-event>

<script type="module" src="{{ 's-collection-view.js' | asset_url }}"></script>

<script type="application/ld+json">
  {{ collection | structured_data }}
</script>
{% endblock %}
