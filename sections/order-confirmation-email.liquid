<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title></title>
    <style></style>
  </head>

  <body>
    <center>
      <table
        align="center"
        border="0"
        cellpadding="0"
        cellspacing="0"
        id="bodyTable"
        width="100%"
        data-upload-file-url="/ajax/email-editor/file/upload"
        data-upload-files-url="/ajax/email-editor/files/upload"
        style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:auto;padding:0;background-color:#ede6e1;height:100%;margin:0;width:100%"
      >
        <tbody>
          <tr>
            <td
              align="center"
              id="bodyCell"
              style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:auto;padding-top:0;padding-left:20px;padding-bottom:50px;padding-right:20px;border-top:0;height:100%;margin:0;width:100%"
              valign="top"
            >
              <!-- [if !mso]><! -->
              <div
                class="templateContainer"
                style="border:0 none #aaa;background-color:#FFF;border-radius:0;display: table; width:600px"
              >
                <div class="templateContainerInner" style="padding:0">
                  <table
                    border="0"
                    cellpadding="0"
                    cellspacing="0"
                    style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                    width="100%"
                  >
                    <tr>
                      <td
                        align="center"
                        style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                        valign="top"
                      >
                        <table
                          border="0"
                          cellpadding="0"
                          cellspacing="0"
                          class="templateRow"
                          style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                          width="100%"
                        >
                          <tbody>
                            <tr>
                              <td
                                class="rowContainer kmFloatLeft"
                                style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                                valign="top"
                              >
                                <table
                                  border="0"
                                  cellpadding="0"
                                  cellspacing="0"
                                  class="kmTextBlock"
                                  style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;margin: 0px;"
                                  width="100%"
                                >
                                  <tbody class="kmTextBlockOuter">
                                    <tr>
                                      <td
                                        class="kmTextBlockInner"
                                        style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;background-color:#ede6e1;margin: 0;padding: 0;"
                                        valign="top"
                                      >
                                        <table
                                          align="left"
                                          border="0"
                                          cellpadding="0"
                                          cellspacing="0"
                                          class="kmTextContentContainer"
                                          style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                                          width="100%"
                                        >
                                          <tbody>
                                            <tr>
                                              <td
                                                class="kmTextContent"
                                                style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;color:#333536;font-family: 'Oswald',sans-serif;font-size:14px;line-height:1.3;letter-spacing:0;text-align:left;max-width:100%;word-wrap:break-word;font-size:20px;color:#FFFFFF;padding-bottom:0px;text-align:center;font-weight:normal;padding:0; "
                                                valign="top"
                                              >
                                                <a
                                                  ref="{{ shop.url }}"
                                                  style="max-width: 100%;display: block;cursor: pointer;"
                                                  target="_blank"
                                                >
                                                  <img
                                                    src="https://cdn.shopify.com/s/files/1/0743/7715/files/2_049c88cb-dc22-49b4-871c-ef70a05d428c.png?v=1763552034"
                                                    alt="Hannah Davis"
                                                    style="max-width: 100%;display: block;"
                                                  >
                                                </a>
                                              </td>
                                            </tr>
                                            <tr>
                                              <td
                                                class="kmTextContent"
                                                style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;color:#333536;font-family: 'Oswald',sans-serif;font-size:14px;line-height:1.3;letter-spacing:0;text-align:left;max-width:100%;word-wrap:break-word;font-size:20px;padding: 0;color:#FFFFFF;text-align:center;font-weight:normal;"
                                                valign="top"
                                              >
                                                <picture style="display: block;">
                                                  <source
                                                    media="(min-width:650px)"
                                                    srcset="https://cdn.shopify.com/s/files/1/0743/7715/files/3_7743e4eb-b1a0-4ddc-a94a-25dffe88ba03.png?v=1763552036"
                                                  >
                                                  <img
                                                    alt="Bang Shoes banner"
                                                    src="https://cdn.shopify.com/s/files/1/0743/7715/files/4_1caff795-5c98-4e85-852d-de0e7c94eba0.png?v=1763552037"
                                                    style="width:100%;display: block;"
                                                  >
                                                </picture>
                                              </td>
                                            </tr>
                                            <tr>
                                              <td
                                                class="kmTextContent"
                                                style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;color:#333536;font-family: 'Oswald',sans-serif;font-size:14px;line-height:1.3;letter-spacing:0;text-align:left;max-width:100%;word-wrap:break-word;font-size:20px;padding: 0;color:#FFFFFF;text-align:center;font-weight:normal;"
                                                valign="top"
                                              >
                                                <h3
                                                  style="background-color:#ede6e1;color:#000;display:block;font-family: 'Oswald',sans-serif;font-size:18px;font-style:normal;font-weight:normal;line-height:1.1;letter-spacing:0;padding:40px 0 12px;margin: 0;text-align:left;text-align:center"
                                                >
                                                  Order ID: #{{ order_number }}
                                                </h3>
                                              </td>
                                            </tr>
                                            <tr>
                                              <td
                                                class="kmTextContent"
                                                style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;color:#333536;font-family: 'Oswald',sans-serif;font-size:14px;line-height:1.3;letter-spacing:0;text-align:left;max-width:100%;word-wrap:break-word;font-size:20px;padding: 0;color:#FFFFFF;text-align:center;font-weight:normal;"
                                                valign="top"
                                              >
                                                <div style="display: block;">
                                                  <img
                                                    src="https://cdn.shopify.com/s/files/1/0743/7715/files/5_fd8b5471-1c9e-4cb5-9799-d4fe18d30e9f.png?v=1763552034"
                                                    alt="Order confirmed"
                                                    style="max-width: 100%;display: block;"
                                                  >
                                                </div>
                                              </td>
                                            </tr>
                                          </tbody>
                                        </table>
                                      </td>
                                    </tr>
                                  </tbody>
                                </table>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>

                    {% comment %} Order details {% endcomment %}
                    <tr>
                      <td
                        align="center"
                        style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                        valign="top"
                      >
                        <table
                          border="0"
                          cellpadding="0"
                          cellspacing="0"
                          class="templateRow"
                          style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                          width="100%"
                        >
                          <tbody>
                            <tr>
                              <td
                                class="rowContainer kmFloatLeft"
                                style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                                valign="top"
                              >
                                <table
                                  border="0"
                                  cellpadding="0"
                                  cellspacing="0"
                                  class="kmTextBlock"
                                  style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                                  width="100%"
                                >
                                  <tbody class="kmTextBlockOuter">
                                    <tr>
                                      <td
                                        class="kmTextBlockInner"
                                        style="color: #000; font-family: 'Oswald',sans-serif; border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;text-align: center;padding: 10px 0;font-weight: normal;background-color:#ede6e1;font-size: 16px;"
                                        valign="top"
                                      >
                                        <p style="font-family: 'Oswald',sans-serif;">
                                          Hey {{ first_name | default: 'friend' }}, we've got good news!
                                        </p>
                                        <p style="font-family: 'Oswald',sans-serif;">
                                          Your order has been placed! Keep an eye out for shipping details soon.
                                        </p>
                                        <p>&nbsp;</p>
                                      </td>
                                    </tr>
                                  </tbody>
                                </table>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>

                    {% comment %} Order content {% endcomment %}
                    <tr>
                      <td
                        align="center"
                        style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;background-color:#ede6e1;"
                        valign="top"
                      >
                        <div style="cursor:default;display: block;">
                          <img
                            src="https://cdn.shopify.com/s/files/1/0743/7715/files/whats_coming-removebg-preview.png?v=1763555117"
                            alt="whats coming"
                            style="max-width: 100%;"
                          >
                        </div>

                        {% for line in line_items %}
                          <table
                            border=" 0"
                            cellpadding="0"
                            cellspacing="0"
                            class="templateRow"
                            style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                            width="100%"
                          >
                            <tbody>
                              <tr style="border-top: 1px solid;">
                                <td
                                  class="rowContainer kmFloatLeft firstColumn"
                                  style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;padding: 10px 0;"
                                  valign="top"
                                  width="20%"
                                >
                                  <table
                                    border="0"
                                    cellpadding="0"
                                    cellspacing="0"
                                    class="kmImageBlock"
                                    style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;min-width:100%"
                                    width="100%"
                                  >
                                    <tbody class="kmImageBlockOuter">
                                      <tr>
                                        <td
                                          class="kmImageBlockInner"
                                          style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;padding:9px;padding-right:9;padding-left:9;"
                                          valign="top"
                                        >
                                          <table
                                            align="left"
                                            border="0"
                                            cellpadding="0"
                                            cellspacing="0"
                                            class="kmImageContentContainer"
                                            style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;min-width:100%"
                                            width="100%"
                                          >
                                            <tbody>
                                              <tr>
                                                <td
                                                  class="kmImageContent"
                                                  style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;padding:0;font-size:0;padding-top:0px;padding-bottom:0;padding-left:9px;padding-right:9px;"
                                                  valign="top"
                                                >
                                                  <img
                                                    align="left"
                                                    alt="{{ line.title }}"
                                                    class="kmImage"
                                                    src="{{ line | img_url: 'small' }}"
                                                    style="
                                                      border:0;height:auto;line-height:100%;outline:none;text-decoration:none;max-width:100%;max-height: 102px;
                                                      object-fit: cover;padding-bottom:0;display:inline;vertical-align:top;font-size:12px;width:100%;margin-right:0;max-width:423px;padding:0;border-width:0;
                                                    "
                                                    width="50"
                                                  >
                                                </td>
                                              </tr>
                                            </tbody>
                                          </table>
                                        </td>
                                      </tr>
                                    </tbody>
                                  </table>
                                </td>
                                <td
                                  class="rowContainer kmFloatLeft lastColumn"
                                  style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                                  valign="top"
                                  width="80%"
                                >
                                  <table
                                    border="0"
                                    cellpadding="0"
                                    cellspacing="0"
                                    class="kmTextBlock"
                                    style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                                    width="100%"
                                  >
                                    <tbody class="kmTextBlockOuter">
                                      <tr>
                                        <td
                                          class="kmTextBlockInner"
                                          style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;"
                                          valign="top"
                                        >
                                          <table
                                            align="left"
                                            border="0"
                                            cellpadding="0"
                                            cellspacing="0"
                                            class="kmTextContentContainer"
                                            style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                                            width="100%"
                                          >
                                            <tbody>
                                              <tr>
                                                <td
                                                  class="kmTextContent"
                                                  style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;color:#333536;font-family: 'Oswald',sans-serif;font-size:14px;line-height:1.3;letter-spacing:0;text-align:left;max-width:100%;word-wrap:break-word;padding-top:9px;padding-bottom:9px;padding-left:18px;padding-right:18px;"
                                                  valign="top"
                                                >
                                                  <h3
                                                    style="color:#333536;display:block;font-family: 'Oswald',sans-serif;font-size:16px;font-style:normal;font-weight:normal;line-height:1.1;letter-spacing:0;margin:0;margin-bottom:12px;margin-top: 5px;text-align:left"
                                                  >
                                                    {{ line.title }}
                                                  </h3>
                                                  <p
                                                    style="margin:0;padding-bottom:1em;font-family:'Oswald',sans-serif;"
                                                  >
                                                    <span
                                                      style="text-align: center;"
                                                    >
                                                      <span
                                                        style="font-size: 14px;color:#222222;font-family:'Oswald',sans-serif;"
                                                        >Quanity:{{ line.quantity }} for {{ line.price | money }} each
                                                      </span>
                                                    </span>
                                                  </p>
                                                  <p
                                                    style="margin:0;padding-bottom:0;font-family:'Oswald',sans-serif;"
                                                  >
                                                    <span
                                                      style="color: rgb(34, 34, 34); font-family: 'Oswald',sans-serif; font-size: 14px; text-align: center;"
                                                      >Total: {{ line.price | money -}}
                                                    </span>
                                                  </p>
                                                </td>
                                              </tr>
                                            </tbody>
                                          </table>
                                        </td>
                                      </tr>
                                    </tbody>
                                  </table>
                                  <table
                                    border="0"
                                    cellpadding="0"
                                    cellspacing="0"
                                    class="kmButtonBlock"
                                    style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;width: 100% !important"
                                    width="100%"
                                  >
                                    <tbody class="kmButtonBlockOuter">
                                      <tr>
                                        <td
                                          align="left"
                                          class="kmButtonBlockInner"
                                          style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;min-width:60px;padding:9px 18px;padding-top:9;padding-bottom:9;padding-left:18;padding-right:18;"
                                          valign="top"
                                        ></td>
                                      </tr>
                                    </tbody>
                                  </table>
                                </td>
                              </tr>
                            </tbody>
                          </table>
                        {% endfor %}
                        <table
                          border="0"
                          cellpadding="0"
                          cellspacing="0"
                          class="templateRow"
                          style="max-width: 100%;border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;border-top: 1px solid;min-width: 100%;"
                          width="100%"
                        >
                          <tbody>
                            <tr style="border-top: 1px solid;min-width: 100%;" align="right">
                              <td
                                class="rowContainer kmFloatLeft"
                                style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                                valign="top"
                                width="100%"
                              >
                                <table
                                  border="0"
                                  cellpadding="0"
                                  cellspacing="0"
                                  class="kmTextBlock"
                                  style="max-width: 100%; border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                                  width="100%"
                                >
                                  <tbody class="kmTextBlockOuter">
                                    <tr>
                                      <td
                                        class="kmTextBlockInner"
                                        style="max-width: 100%;border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;"
                                        valign="top"
                                      >
                                        <table
                                          align="right"
                                          border="0"
                                          cellpadding="0"
                                          cellspacing="0"
                                          class="kmTextContentContainer"
                                          style="max-width: 100%;border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;"
                                          width="100%"
                                        >
                                          <tbody>
                                            <tr>
                                              <td
                                                align="right"
                                                class="kmTextContent"
                                                style="max-width: 100%;border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;color:#333536;font-family: 'Oswald',sans-serif;font-size:14px;line-height:1.3;letter-spacing:0;text-align:right;max-width:100%;word-wrap:break-word;padding-top:9px;padding-bottom:9px;padding-left:18px;padding-right:18px;"
                                                valign="top"
                                                width="100%"
                                              >
                                                {% if discounts %}
                                                  <p
                                                    style="margin:0;padding-bottom:1em;font-family:'Oswald',sans-serif;"
                                                  >
                                                    <span
                                                      style="text-align: center;"
                                                    >
                                                      <span
                                                        style="font-size: 14px;font-family:'Oswald',sans-serif;"
                                                        >Discounts :</span
                                                      >
                                                      <span> {{ discounts_savings | money_with_currency }}</span>
                                                    </span>
                                                  </p>
                                                {% endif %}
                                                <p
                                                  style="margin:0;padding-bottom:1em;font-family:'Oswald',sans-serif;"
                                                >
                                                  <span
                                                    style="text-align: center;"
                                                  >
                                                    <span
                                                      style="font-size: 14px;color:#222222;font-family:'Oswald',sans-serif;"
                                                      >Subtotal : </span
                                                    ><span>{{ subtotal_price | money_with_currency }}</span>
                                                  </span>
                                                </p>
                                                {% for tax_line in tax_lines %}
                                                  <p
                                                    style="margin:0;padding-bottom:1em;font-family:'Oswald',sans-serif;"
                                                  >
                                                    <span
                                                      style="text-align: center;"
                                                    >
                                                      <span
                                                        style="font-size: 14px;color:#222222;font-family:'Oswald',sans-serif;"
                                                      >
                                                        {{- tax_line.title }} :</span
                                                      ><span>{{ tax_line.price | money_with_currency }} </span>
                                                    </span>
                                                  </p>
                                                {% endfor %}
                                                {% if requires_shipping %}
                                                  <p
                                                    style="margin:0;padding-bottom:1em;font-family:'Oswald',sans-serif;"
                                                  >
                                                    <span
                                                      style="text-align: center;"
                                                    >
                                                      <span
                                                        style="font-size: 14px;color:#222222;font-family:'Oswald',sans-serif;"
                                                        >Shipping : </span
                                                      ><span>{{ shipping_price | money_with_currency }}</span>
                                                    </span>
                                                  </p>
                                                {% endif %}
                                                <p
                                                  style="margin:0;padding-bottom:1em;font-family:'Oswald',sans-serif;"
                                                >
                                                  <span
                                                    style="text-align: center;"
                                                  >
                                                    <span
                                                      style="font-size: 14px;color:#222222;font-family:'Oswald',sans-serif;"
                                                      >Total : </span
                                                    ><span>{{ total_price | money_with_currency }} </span>
                                                  </span>
                                                </p>
                                              </td>
                                            </tr>
                                          </tbody>
                                        </table>
                                      </td>
                                    </tr>
                                  </tbody>
                                </table>
                                <table
                                  border="0"
                                  cellpadding="0"
                                  cellspacing="0"
                                  class="kmButtonBlock"
                                  style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;width: 100% !important"
                                  width="100%"
                                >
                                  <tbody class="kmButtonBlockOuter">
                                    <tr>
                                      <td
                                        align="left"
                                        class="kmButtonBlockInner"
                                        style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;min-width:60px;padding:9px 18px;padding-top:9;padding-bottom:9;padding-left:18;padding-right:18;"
                                        valign="top"
                                      ></td>
                                    </tr>
                                  </tbody>
                                </table>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>

                    {% comment %} Whats coming / On its way {% endcomment %}
                    <tr>
                      <td
                        align="center"
                        style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                        valign="top"
                      >
                        <table
                          border="0"
                          cellpadding="0"
                          cellspacing="0"
                          class="templateRow"
                          style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                          width="100%"
                        >
                          <tbody>
                            <tr>
                              <td
                                class="rowContainer kmFloatLeft"
                                style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                                valign="top"
                              >
                                <table
                                  border="0"
                                  cellpadding="0"
                                  cellspacing="0"
                                  class="kmTextBlock"
                                  style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed"
                                  width="100%"
                                >
                                  <tbody class="kmTextBlockOuter">
                                    <tr>
                                      <td
                                        class="kmTextBlockInner"
                                        style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;table-layout:fixed;background-color:#ede6e1;"
                                        valign="top"
                                      >
                                        <div
                                          style="cursor:default;display: block;"
                                        >
                                          <img
                                            src="https://cdn.shopify.com/s/files/1/0743/7715/files/on_its_way-removebg-preview.png?v=1763555117"
                                            alt="on its way"
                                            style="max-width: 100%;"
                                          >
                                        </div>

                                        <table
                                          border="0"
                                          cellpadding="0"
