      <script id="custom-js-gdN-EIJaE7">
        try {
          let players = [];
let buttons = document.querySelectorAll(".playPause7");
buttons.forEach(button => {
    
    wavesurferContainer = '#' + button.parentNode.querySelector('.wavesurfer-container7').getAttribute('id');   
    
    var wavesurfer7 = WaveSurfer.create({
      container: wavesurferContainer,
      waveColor: '#FFFFFF',
      progressColor: '#DB57DE',
      height: '40',
      cursorWidth: '0',
      hideScrollbar: 'true',
      backend: 'MediaElement'
    });

    var obj = {};
    obj["button"] = button;
    obj["player"] = wavesurfer7;
    
    players.push(obj);
    
    wavesurfer7.load( 'https://cdn.shopify.com/s/files/1/0541/0101/6759/files/Female_Vocal_Loop.mp3?v=1694552019');
    
    button.addEventListener('click', (e) => {
      if (wavesurfer7.isPlaying()) {
        wavesurfer7.pause();
        button.src = 'https://cdn.shopify.com/s/files/1/0541/0101/6759/files/white_play_icon_ee8f59d9-e1ce-49b4-ac6b-829dad006a0e.png?v=1684068399';
      } else {
          console.log(players, 'players');
          
          players.forEach(function (element) {
            if(element.player.isPlaying() && wavesurfer7 != element.player){
                element.player.pause();
                element.button.src = 'https://cdn.shopify.com/s/files/1/0541/0101/6759/files/white_play_icon_ee8f59d9-e1ce-49b4-ac6b-829dad006a0e.png?v=1684068399';
            }
          });
        wavesurfer7.play();
        button.src = 'https://cdn.shopify.com/s/files/1/0541/0101/6759/files/pause-icon-18-256.png?v=1684068402';
          
      }
    });
  });
