<!doctype html>
{%- comment -%} dir comes from the platform (request.locale.direction); never derive it from a theme-local RTL language list. {%- endcomment -%}
<html lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
  <head>
    {%- comment -%} The import map must precede the first module script, so it stays first in the head. {%- endcomment -%}
    {% render 'import-map' %}
    {% render 'meta-tags' %}
    {{ 'styles.min.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'theme-styles' %}

    {% render 'lcp-preload' %}

    {%- comment -%}
      Standard Actions configuration must register before content_for_header so
      platform cart mutations use the theme handler instead of the full-page fallback.
    {%- endcomment -%}
    {% render 'standard-actions-config' %}

    {{ content_for_header }}
  </head>

  <body class="flex flex-col min-h-svh bg-surface text-on-surface font-body antialiased">
    <div style="display:none"> {% render 'skip-link' %} </div>
    {% block 'header', class: 'relative z-40 border-b border-on-surface/15 bg-surface' %}
      <div
        class="flex items-center justify-between min-h-16 px-margin py-2 max-w-page mx-auto w-full"
        data-header-nav-group
      >
        <div class="flex shrink-0 items-center gap-2">
          <div class="hidden max-md:block ms-[min(0px,calc(var(--safe-area-inset-inline)-0.5rem))]">
            {%- capture menu_button_attrs -%}aria-label="{{ 'header.menu' | t | escape }}"{%- endcapture -%}
            {% block 'button',
              commandfor: 'mobile-nav-drawer',
              command: 'show-modal',
              variant: 'button-ghost',
              class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70',
              attributes: menu_button_attrs -%}
              <span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">
                {{- 'icon-menu.svg' | inline_asset_content -}}
              </span>
            {%- endblock %}
          </div>

          {% block 'logo', class: 'font-heading text-2xl md:text-3xl font-medium tracking-[-0.01em]' %}{% endblock %}
        </div>

        {%- capture mobile_nav_close_button -%}
          {%- capture nav_close_button_attrs -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
          {% block 'button', commandfor: 'mobile-nav-drawer', command: 'close', variant: 'button-ghost', class: 'ms-auto size-touch-target rounded hover:bg-transparent hover:opacity-70', attributes: nav_close_button_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
        {%- endcapture -%}
        {%- capture mobile_nav_localization_submit -%}
          {% block 'button', type: 'submit', variant: 'button-secondary', class: 'h-11 rounded-button px-3 text-xs' %}{{ 'localization.update_language' | t }}{% endblock %}
        {%- endcapture -%}
        {% block 'main-menu', mobile_nav_close_button: mobile_nav_close_button, mobile_nav_localization_submit: mobile_nav_localization_submit %}{% endblock %}

        <div class="flex shrink-0 items-center gap-0">
          {%- capture header_localization_submit -%}
            {% block 'button', type: 'submit', variant: 'button-secondary', class: 'h-11 rounded-button px-3 text-xs' %}{{ 'localization.update_language' | t }}{% endblock %}
          {%- endcapture -%}
          <div style="display:none"> {% render 'localization-form', show_country: true, id: 'header-localization', class: 'hidden md:block me-2', submit_button: header_localization_submit %} </div>

          {%- capture search_button_attrs -%}aria-label="{{ 'general.search' | t | escape }}"{%- endcapture -%}
          {% block 'button',
            commandfor: 'predictive-search',
            command: 'show-modal',
            variant: 'button-ghost',
            class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70',
            attributes: search_button_attrs -%}
            <span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">
              {{- 'icon-search.svg' | inline_asset_content -}}
            </span>
          {%- endblock %}

          {% if shop.customer_accounts_enabled %}
            
            <shopify-account
              menu="customer-account-main-menu"
              title="{{ 'general.account' | t | escape }}"
              class="inline-flex h-11 min-w-11 items-center justify-center rounded text-on-surface hover:opacity-70 motion-safe:transition motion-safe:active:scale-[0.97] [--shopify-account-avatar-size:2.75rem] [--shopify-account-signed-in-avatar-size:1.75rem] [--shopify-account-signed-in-avatar-color-background:var(--color-interactive)] [--shopify-account-signed-in-avatar-color-text:var(--color-interactive-text)] [--shopify-account-font-heading:var(--font-heading)] [--shopify-account-font-heading-weight:300] [--shopify-account-font-body:var(--font-body)] [--shopify-account-font-body-weight:400] [--shopify-account-radius-base:var(--radius-card)] [--shopify-account-radius-button:var(--radius-button)] [--shopify-account-radius-button-small:var(--radius-button)] [--shopify-account-radius-input:var(--radius-input)] [--shopify-account-color-background:var(--color-surface)] [--shopify-account-color-text:var(--color-on-surface)] [--shopify-account-color-accent:var(--color-interactive)] [--shopify-account-color-accent-text:var(--color-interactive-text)] [--shopify-account-dialog-position-top:6.5rem] not-[&:defined]:flex not-[&:defined]:h-11 not-[&:defined]:min-w-11 not-[&:defined]:items-center not-[&:defined]:justify-center"
            >
              {% if customer %}
                <div class="size-7 rounded-full bg-interactive" aria-hidden="true"></div>
              {% else %}
                <span
                  slot="signed-out-avatar"
                  class="inline-flex size-5 items-center justify-center [&_svg]:size-full"
                  aria-hidden="true"
                >
                  {{- 'icon-account.svg' | inline_asset_content -}}
                </span>
              {% endif %}
            </shopify-account>
          {% endif %}

          
          {% partial 'cart-count' %}
            
            {%- capture cart_button_attrs -%}id="header-cart-trigger" aria-label="{{ 'cart.icon_label' | t: count: cart.item_count | escape }}"{%- endcapture -%}
            {% block 'button',
              commandfor: 'cart-drawer',
              command: 'show-modal',
              variant: 'button-ghost',
              class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70',
              attributes: cart_button_attrs -%}
              <span class="relative inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">
                {{- 'icon-cart.svg' | inline_asset_content -}}
                {% if cart.item_count > 0 -%}
                  <span class="absolute top-0 inset-e-0 translate-x-1/2 rtl:-translate-x-1/2 -translate-y-1/2 flex items-center justify-center size-5 text-xs font-medium bg-interactive text-interactive-text rounded-full">
                    {{- cart.item_count -}}
                  </span>
                {%- endif -%}
              </span>
            {%- endblock %}
            <span aria-live="polite" aria-atomic="true" class="sr-only">
              {{ 'cart.item_count' | t: count: cart.item_count }}
            </span>
          {% endpartial %}
        </div>
      </div>
      {% block 'predictive-search' %}
        
        
        <s-live-form class="block" partial="predictive-results,predictive-meta" debounce="300" data-no-url-sync data-updated-message="{{ 'accessibility.results_updated' | t }}" data-error-message="{{ 'accessibility.update_error' | t }}">
          <form action="{{ routes.search_url }}" method="get">
            {% partial 'predictive-meta' %}
              <span data-results-count hidden>{{ search.results_count }}</span>
            {% endpartial %}
            <div class="relative flex items-center gap-1 py-3 border-b border-border shrink-0 ps-3">
              <span class="inline-flex items-center justify-center shrink-0 size-5 text-on-surface-secondary" aria-hidden="true">{{- 'icon-search.svg' | inline_asset_content -}}</span>
              <label for="predictive-search-input" class="sr-only">{{ 'search.placeholder' | t }}</label>
              <input
                id="predictive-search-input"
                type="search"
                name="q"
                role="combobox"
                aria-autocomplete="list"
                aria-controls="predictive-search-listbox"
                aria-expanded="false"
                placeholder="{{ 'search.placeholder' | t | escape }}"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                autofocus
                class="peer flex-1 bg-transparent text-on-surface text-base outline-none border-none placeholder:text-on-surface-secondary [&::-webkit-search-cancel-button]:hidden ps-1.5"
              >
              
              <button
                type="button"
                data-clear-search
                aria-label="{{ 'general.clear' | t }}"
                class="inline-flex items-center shrink-0 min-h-6 text-sm text-on-surface-secondary hover:text-on-surface motion-safe:transition-[color,transform] motion-safe:active:scale-[0.97] cursor-pointer peer-placeholder-shown:hidden pe-2.5 me-2"
              >{{ 'general.clear' | t }}</button>
              
              <span class="absolute inset-y-0 inset-e-[calc(2.25rem+16px)] w-px bg-border peer-placeholder-shown:hidden" aria-hidden="true"></span>
              <button
                type="button"
                commandfor="predictive-search"
                command="close"
                class="inline-flex items-center justify-center shrink-0 size-9 rounded text-on-surface-secondary hover:text-on-surface hover:bg-surface-secondary cursor-pointer motion-safe:transition-[color,background-color,transform] motion-safe:active:scale-[0.97] me-2"
                aria-label="{{ 'general.close' | t }}"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              </button>
            </div>
          </form>
        </s-live-form>

        {% partial 'predictive-results' %}
          <div class="relative flex-1 min-h-0">
            <div id="predictive-search-listbox" role="listbox" aria-label="{{ 'search.results_heading' | t }}" class="h-full overflow-y-auto p-4 pb-20">
              {% if search.performed and search.terms != blank %}
                {% if search.results_count > 0 %}
                  {%- assign has_products = false -%}
                  {%- assign option_index = 0 -%}
                  {%- assign product_count = 0 -%}
                  
                  {%- assign predictive_product_sizes = '(min-width: 800px) 169px, (min-width: 768px) calc((90vw - 44px) / 4), calc((100vw - 36px) / 2)' -%}
                  {%- capture product_items -%}{%- endcapture -%}

                  {%- for result in search.results -%}
                    {%- if result.object_type == 'product' -%}
                      {%- assign product_count = product_count | plus: 1 -%}
                      {%- if product_count <= 8 -%}
                        {%- assign has_products = true -%}
                        {%- capture product_items -%}
                          {{- product_items -}}
                          <li id="ps-option-{{ option_index }}" role="option" aria-selected="false" data-ps-url="{{ result.url | escape }}">
                            {%- # theme-check-disable-next-line UnknownFilter %}
                            <s-view-event class="block" view-event-trigger="intersect" view-event-payload="{{ result | standard_event_data: 'view', context: 'dialog' | escape }}">
                              {%- assign card_variant = result.selected_or_first_available_variant -%}
                              {% block 'card', block.name: 't:blocks.product_card', url: result.url, aria_label: result.title, border_radius: 'rounded-card' %}
                                <a href="{{ result.url | escape }}" class="relative block overflow-hidden rounded-[inherit]" aria-label="{{ result.title | escape }}">
                                  {% block 'image', fallback_image: result.featured_image, aspect_ratio: 'aspect-square', alt: result.title, sizes: predictive_product_sizes, seed: product_count, attributes: 'loading="lazy"' %}{% endblock %}
                                </a>
                                <div class="flex flex-col gap-0.5">
                                  {% block 'text', tag: 'h3', variant: 'type-body-sm', class: 'font-medium text-on-surface line-clamp-2' %}{{ result.title | escape }}{% endblock %}
                                  {% block 'price', price: card_variant.price, compare_at_price: card_variant.compare_at_price, price_min: result.price_min, price_max: result.price_max, class: 'text-sm font-medium self-start group-[.text-center]/card:self-center group-[.text-end]/card:self-end' %}{% endblock %}
                                </div>
                              {% endblock %}
                            </s-view-event>
                          </li>
                        {%- endcapture -%}
                        {%- assign option_index = option_index | plus: 1 -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if has_products -%}
                    <div role="group" aria-labelledby="ps-heading-products">
                      <h3 id="ps-heading-products" class="text-sm font-medium text-on-surface mb-3">
                        {{ 'search.products_heading' | t }}
                      </h3>
                      <ul class="grid grid-cols-2 md:grid-cols-4 gap-x-1 gap-y-3">
                        {{ product_items }}
                      </ul>
                    </div>
                  {%- endif -%}

                  <div class="sr-only" data-ps-result-count="{{ search.results_count }}">
                    {{ 'search.results_count_announcement' | t: count: search.results_count }}
                  </div>
                {% else %}
                  
                  {%- assign clean_search_terms = search.terms | strip_html | escape -%}
                  <p class="text-on-surface-secondary text-sm py-8 text-center">
                    {{ 'search.no_results' | t: terms: clean_search_terms }}
                  </p>
                  <div class="sr-only" data-ps-result-count="0">
                    {{ 'search.no_results_announcement' | t: terms: clean_search_terms }}
                  </div>
                {% endif %}
              {% endif %}
            </div>

            
            {%- if search.performed and search.terms != blank and search.results_count > 0 -%}
              {%- assign encoded_search_terms = search.terms | url_encode -%}
              {%- assign view_all_results_url = routes.search_url | append: '?q=' | append: encoded_search_terms -%}
              <div data-fade-overlay class="absolute bottom-0 inset-x-0 flex items-end justify-center px-4 pb-4 pt-20 bg-linear-to-t from-surface to-transparent pointer-events-none">
                <div class="pointer-events-auto">
                  {% block 'button', url: view_all_results_url, variant: 'button-primary', class: 'h-11 px-14 text-sm rounded-button' %}{{ 'search.view_all_results' | t }}{% endblock %}
                </div>
              </div>
            {%- endif -%}
          </div>
        {% endpartial %}
      {% endblock %}

      <script type="module" src="{{ 's-predictive-search.js' | asset_url }}"></script>
      <script type="module" src="{{ 's-live-form.js' | asset_url }}"></script>

      
      {%- capture cart_drawer_content -%}
        <s-cart class="block" id="cart-drawer-items" data-partials="cart-drawer,cart-count,cart-drawer-count,cart-drawer-footer">
          {% partial 'cart-drawer' %}
          
          {%- # theme-check-disable UnknownFilter %}
          <script type="application/json" data-view-event-payload>{{ cart | standard_event_data: 'view', context: 'dialog' }}</script>
          {%- # theme-check-enable UnknownFilter %}
          {% if cart.item_count > 0 %}
            <div class="divide-y divide-border -mt-4">
              {% for item in cart.items %}
                
                {%- capture line_media -%}
                  {% if item.image %}{% block 'image', fallback_image: item.image, sizes: '64px', widths: '64,128', alt: item.product.title, class: 'size-full object-contain', attributes: 'loading="lazy"' %}{% endblock %}{% endif %}
                {%- endcapture -%}
                {%- capture line_unit_price -%}
                  {% block 'price', price: item.original_price, class: 'text-xs font-medium [&_span]:text-on-surface-secondary' %}{% endblock %}
                {%- endcapture -%}
                {%- assign remove_label = 'cart.remove' | t: title: item.product.title -%}
                {%- capture line_remove_attributes -%}aria-label="{{ remove_label | escape }}" data-variant-id="{{ item.variant_id }}" data-line-key="{{ item.key | escape }}"{%- endcapture -%}
                {%- capture line_remove_button -%}
                  {% block 'button', commandfor: 'cart-drawer-items', command: '--remove', variant: 'button-ghost', class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70', attributes: line_remove_attributes %}<span class="inline-flex items-center justify-center shrink-0 size-4" aria-hidden="true">{{- 'icon-trash.svg' | inline_asset_content -}}</span>{% endblock %}
                {%- endcapture -%}
                {% render 'cart-line-item', item: item, cart_id: 'cart-drawer-items', compact: true, media: line_media, unit_price: line_unit_price, remove_button: line_remove_button %}
              {% endfor %}
            </div>
          {% else %}
            <p class="text-on-surface-secondary text-sm py-8 text-center">{{ 'cart.empty' | t }}</p>
          {% endif %}
          {% endpartial %}
        </s-cart>
      {%- endcapture -%}

      {%- capture cart_drawer_footer -%}
        {% partial 'cart-drawer-footer' %}
        {% if cart.item_count > 0 %}
          
          <s-cart class="block" id="cart-drawer-summary" data-partials="cart-drawer,cart-count,cart-drawer-count,cart-drawer-footer">
            {% form 'cart', cart, class: 'flex flex-col gap-3' %}
              {% render 'cart-discount-list', cart: cart %}
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-on-surface">{{ 'cart.total_label' | t }}</span>
                <span class="text-base font-medium text-on-surface [view-transition-name:cart-total]" data-cart-total><bdi>{{ cart.total_price | money }}</bdi></span>
              </div>
              {% block 'button', type: 'submit', name: 'checkout', variant: 'button-primary', class: 'h-11 px-4 text-sm rounded-button w-full' %}{{- 'cart.checkout' | t -}}{% endblock %}

              
              {% if additional_checkout_buttons %}
                <div class="additional-checkout-buttons border-t border-border pt-3 [--shopify-accelerated-checkout-button-block-size:var(--spacing-touch-target)] [--shopify-accelerated-checkout-button-border-radius:var(--radius-button)] [--shopify-accelerated-checkout-button-box-shadow:none] [--shopify-accelerated-checkout-skeleton-background-color:var(--color-surface-secondary)]">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {% endif %}

              {% render 'cart-discount-code', cart_id: 'cart-drawer-summary', input_id: 'cart-drawer-discount-input' %}
            {% endform %}
          </s-cart>
        {% endif %}
        {% endpartial %}
      {%- endcapture -%}

      {%- capture cart_drawer_header -%}
        <div class="flex items-center shrink-0 ps-4 py-2">
          <div class="flex items-center gap-2 flex-1">
            <h2 id="cart-drawer-title" class="text-lg font-medium text-on-surface">{{ 'cart.title' | t }}</h2>
            
            {% partial 'cart-drawer-count' %}
              {% if cart.item_count > 0 %}
                
                <span class="flex items-center justify-center text-xs font-medium bg-surface-secondary text-on-surface rounded-full size-5.5">{{ cart.item_count }}</span>
              {% endif %}
            {% endpartial %}
          </div>
          {%- capture cart_close_button_attrs -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
          {% block 'button', commandfor: 'cart-drawer', command: 'close', variant: 'button-ghost', class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70', autofocus: true, attributes: cart_close_button_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
        </div>
      {%- endcapture -%}
      {% render 'cart-drawer',
        header: cart_drawer_header,
        content: cart_drawer_content,
        footer: cart_drawer_footer,
        attributes: 'aria-labelledby="cart-drawer-title"'
      %}
    {% endblock %}

    <main class="flex-1" id="main-content" tabindex="-1" data-template="{{ request.page_type }}">
      
      <div style="{% render 'theme-type-scale-variables' %}">
        {{ content_for_layout }}
      </div>
    </main>

    {% render 'sr-announcer' %}

    
    {% block 'footer', class: 'w-full bg-interactive text-interactive-text border-t border-interactive-text/15' %}
      <div class="max-w-page mx-auto px-margin md:px-10 pt-16 md:pt-24 flex flex-col">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-10 pb-12 md:pb-20">
          <div class="md:col-span-6 flex flex-col gap-4">
            {% block 'text', tag: 'p', variant: 'type-display', class: 'text-5xl md:text-(length:--type-heading-2xl-size) leading-[1.0] tracking-[-0.015em]' %}
              {{- 'footer_signoff.heading' | t -}}
            {% endblock %}
            {% block 'text', variant: 'type-body', class: 'opacity-75 max-w-md' %}
              {{- 'footer_signoff.body' | t -}}
            {% endblock %}
          </div>

          <div class="md:col-span-5 md:col-start-8 flex flex-col gap-4 md:pt-3">
            {% block 'text', tag: 'h2', variant: 'type-heading-md' %}
              {{- 'footer_signoff.newsletter_heading' | t -}}
            {% endblock %}
            {% block 'text', variant: 'type-body', class: 'opacity-75 max-w-[44ch]' %}
              {{- 'footer_signoff.newsletter_body' | t -}}
            {% endblock %}
            {% block 'newsletter-form', class: 'mt-2' %}{% endblock %}
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 md:gap-10 border-t border-interactive-text/20 md:pt-12 md:pb-16">
          {%- assign footer_menu_shop = linklists['main-menu'] -%}
          {%- assign footer_menu_help = linklists['help'] -%}
          {%- assign footer_menu_info = linklists['footer'] -%}
          {% block 'footer-menu-column', menu: footer_menu_shop, class: 'md:col-span-3' %}
            {% block 'text', tag: 'h2', variant: 'type-overline', class: 'tracking-[0.18em]' %}{{- 'footer_signoff.column_shop' | t -}}{% endblock %}
          {% endblock %}
          {% block 'footer-menu-column', menu: footer_menu_help, class: 'md:col-span-3' %}
            {% block 'text', tag: 'h2', variant: 'type-overline', class: 'tracking-[0.18em]' %}{{- 'footer_signoff.column_help' | t -}}{% endblock %}
          {% endblock %}
          {% block 'footer-menu-column', menu: footer_menu_info, class: 'md:col-span-3' %}
            {% block 'text', tag: 'h2', variant: 'type-overline', class: 'tracking-[0.18em]' %}{{- 'footer_signoff.column_info' | t -}}{% endblock %}
          {% endblock %}
        </div>

        <div class="border-t border-interactive-text/20 py-6 flex flex-col gap-3 text-xs text-interactive-text/70 md:flex-row md:flex-wrap md:items-center md:justify-between [&_a]:text-interactive-text/70 [&_a:hover]:text-interactive-text">
          <p class="m-0">
            &copy; {{ 'now' | date: '%Y' }}
            {{ shop.name }}
          </p>

          
          {% if shop.policies.size > 0 %}
            <nav aria-label="{{ 'footer.policies' | t | escape }}">
              <ul role="list" class="flex flex-wrap gap-x-4 gap-y-2">
                {%- for policy in shop.policies -%}
                  {%- if policy != blank -%}
                    <li>
                      <a
                        href="{{ policy.url }}"
                        class="inline-flex items-center min-h-touch-target font-normal no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-interactive-text motion-safe:transition-colors"
                      >
                        {{ policy.title | escape }}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </nav>
          {% endif %}

          <p class="m-0 [&_a]:no-underline [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-2 [&_a:focus-visible]:outline-interactive-text [&_a]:motion-safe:transition-colors">
            {{ powered_by_link }}
          </p>
        </div>
      </div>

    {% endblock %}

    {% render 'notification-host' %}
    {% render 'theme-scripts' %}
    {% render 'command-polyfill' %}
  </body>
</html>
