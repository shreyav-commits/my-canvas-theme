{% doc %}
  Image tile for a mega menu link or product. The image comes from the link's resource:
  a collection's featured image (falls back to its first product), a product's
  featured image, an article's image, or the catalog's first product. Links
  without an image get the theme's placeholder texture.

  @param {object} link - Menu link to render. @required
  @param {string} [aspect_ratio] - Aspect ratio utility for the image frame. Default: 'aspect-[3/4]'.
  @param {string} [sizes] - Responsive sizes attribute. Default: '240px'.
  @param {number} [seed] - Placeholder seed.
{% enddoc %}

{%- liquid
  assign aspect_ratio = aspect_ratio | default: 'aspect-[3/4]'
  assign sizes = sizes | default: '240px'
  # Products (used when a collection link lists its products) carry their own image.
  assign tile_image = link.featured_image
  if tile_image == blank
  case link.type
    when 'collection_link'
      assign tile_image = link.object.featured_image
    when 'product_link'
      assign tile_image = link.object.featured_image
    when 'article_link'
      assign tile_image = link.object.image
    when 'catalog_link'
      assign tile_image = collections.all.products.first.featured_image
  endcase
  endif
-%}

<a href="{{ link.url }}" class="group/tile flex flex-col gap-3 no-underline text-on-surface focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-on-surface"{% if link.current %} aria-current="page"{% endif %}>
  <span class="relative block overflow-hidden bg-surface-secondary {{ aspect_ratio }}">
    {%- if tile_image != blank -%}
      {{ tile_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: sizes, widths: '240,360,480,600', alt: link.title, class: 'absolute inset-0 size-full object-cover motion-safe:transition-transform motion-safe:duration-500 group-hover/tile:scale-[1.03]' }}
    {%- else -%}
      {% render 'placeholder-texture', kind: 'image', seed: seed, class: 'absolute inset-0 size-full aspect-auto', alt: link.title %}
    {%- endif -%}
  </span>
  <span class="flex items-center justify-between gap-3 text-xs font-medium uppercase tracking-[0.14em]">
    <span class="min-w-0 truncate">{{ link.title | escape }}</span>
    <span class="inline-flex size-3.5 shrink-0 opacity-0 -translate-x-1 motion-safe:transition-[opacity,transform] group-hover/tile:opacity-100 group-hover/tile:translate-x-0 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-arrow-right.svg' | inline_asset_content -}}</span>
  </span>
</a>
