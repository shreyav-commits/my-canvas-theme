{% doc %}
  Cart drawer upsell shell for a caller-authored product row from a chosen collection.
  The caller owns the collection source, heading, and product cards; the pre-rendered
  body is placed inside this region. It cannot read this block's settings from the body.

  The collection setting is an editor binding: callers pass the same resource their body
  reads (`collection: upsell_collection`), and the editor's picker follows that value's
  provenance to rewrite the caller's `collections.<handle>` source.

  @param {string} [class] - Additional CSS classes on the root element.
  @param {string} [attributes] - Additional HTML attributes passed through to the root element.

  @category commerce
  @renders section

  @example
  {% assign upsell_collection = collections.all %}
  {% block 'cart-upsell', collection: upsell_collection %}
    {% block 'text', tag: 'h3', variant: 'type-heading-sm' %}You might also love{% endblock %}
  {% endblock %}
{% enddoc %}

<section class="flex flex-col gap-4{{ class | prepend: ' ' }}"{% if attributes != blank %} {{ attributes }}{% endif %}>
  {{ content }}
</section>

{% schema %}
  {
    "name": "t:blocks.cart_upsell",
    "settings": [
      {
        "type": "collection",
        "id": "collection",
        "label": "t:general.collection"
      }
    ]
  }
{% endschema %}
