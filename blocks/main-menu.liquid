{% doc %}
  Renders the primary navigation. The desktop `<nav>` uses multi-level
  `s-nav-dropdown` behavior; the specialized mobile drawer is composed from
  this block so both presentations use the same selected menu. When no menu is
  selected, the standard `main-menu` link list is used automatically. If that
  fallback has no links, the desktop nav is omitted while the mobile drawer
  remains available for its localization controls. Optional body content
  renders before the desktop link list.

  @param {string} [class] - Additional CSS classes on the desktop `<nav>` element. Overrides the default desktop layout classes when set.
  @param {string} [attributes] - Additional HTML attributes passed through to the root `<nav>` element.
  @param {string} mobile_nav_close_button - Captured layout-owned close button for mobile-nav-drawer. @required
  @param {string} mobile_nav_localization_submit - Captured layout-owned submit button for the mobile language selector. @required

  @category navigation
  @renders nav

  @example
  {%- capture close_attributes -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
  {%- capture mobile_close -%}
    {% block 'button', commandfor: 'mobile-nav-drawer', command: 'close', variant: 'button-ghost', class: 'ms-auto size-touch-target rounded hover:bg-transparent hover:opacity-70', attributes: close_attributes %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
  {%- endcapture -%}
  {% capture update_button %}
    {% block 'button', type: 'submit', variant: 'button-secondary' %}{{ 'localization.update_language' | t }}{% endblock %}
  {% endcapture %}
  {% block 'main-menu', mobile_nav_close_button: mobile_close, mobile_nav_localization_submit: update_button %}{% endblock %}
{% enddoc %}

{%- liquid
  assign menu = menu | default: linklists.main-menu

  assign variant = variant | default: 'type-body'
  assign text_color = color
  assign dropdown_color = dropdown_color
  # Liquid fallbacks mirror the schema defaults; layout-authored blocks render with blank settings until saved in the editor.
  assign menu_style = menu_style | default: 'mega_menus_images'
  assign is_mega = false
  if menu_style == 'mega_menus' or menu_style == 'mega_menus_images' or menu_style == 'mega_images'
    assign is_mega = true
  endif
  assign mega_collection_keys = '|'
  assign mega_collection_list = mega_collection_items | default: 'Shop Mihigh, Education Center' | split: ','
  for mega_title in mega_collection_list
    assign mega_key = mega_title | downcase | strip
    if mega_key != blank
      assign mega_collection_keys = mega_collection_keys | append: mega_key | append: '|'
    endif
  endfor

  assign nav_class = class | default: 'hidden md:flex min-w-0 flex-1 flex-wrap items-center gap-x-8 gap-y-2 mx-8'
-%}

{% if menu.links.size > 0 %}
<nav aria-label="{{ 'header.navigation' | t }}" class="{{ nav_class }}" data-desktop-nav {% if attributes != blank %}{{ attributes }}{% endif %}>
  {{ content }}
  {%- comment -%} role="list" keeps the list structure exposed to assistive tech (it communicates the navigation hierarchy, and VoiceOver drops list semantics when there is no list-style); display:contents keeps the items as direct flex children of the <nav> so the existing flex-wrap layout is unchanged. {%- endcomment -%}
  <ul role="list" class="contents">
  {% for link in menu.links %}
    {%- liquid
      # A top-level link without sub-links opens the menu whose handle matches it (e.g. "Our Story" -> our-story), so each item can have its own mega menu.
      assign child_links = link.links
      if child_links.size == 0 and link.handle != menu.handle
        assign mapped_menu = linklists[link.handle]
        if mapped_menu.links.size > 0
          assign child_links = mapped_menu.links
        endif
      endif
      # Mega styles only: a collection link listed in "Mega menu collections" with no sub-links or matching menu shows that collection's products.
      if is_mega and child_links.size == 0 and link.type == 'collection_link'
        assign link_key = link.title | downcase | strip | prepend: '|' | append: '|'
        if mega_collection_keys contains link_key and link.object.products_count > 0
          assign child_links = link.object.products
        endif
      endif
    -%}
    {% if child_links.size > 0 %}
      {%- assign panel_id = 'nav-panel-' | append: forloop.index -%}
      {%- assign disclosure_title = link.title | escape -%}
      {%- capture disclosure_label -%}{{ 'header.show_submenu' | t: title: disclosure_title }}{%- endcapture -%}
      {%- if is_mega -%}
      {%- comment -%} Mega menu: full-width panel anchored to the header. Leaf links form one column; links with children each get a column; image styles add tiles from each link's collection, product, or article image. {%- endcomment -%}
      <s-nav-dropdown class="nav-has-dropdown nav-has-mega" role="listitem">
        <span class="relative inline-flex items-center">
        <a href="{{ link.url }}"
          class="nav-mega-trigger {{ variant }} shrink-0 no-underline{% if text_color == blank %} text-on-surface{% endif %} hover:opacity-70 motion-safe:transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm whitespace-nowrap"
          {%- if text_color != blank %} style="color: {{ text_color }}"{% endif %}
          {%- if link.current %} aria-current="page"{% endif %}>
          {{ link.title | escape }}
        </a>
        <button type="button" class="nav-disclosure" data-nav-disclosure aria-controls="{{ panel_id }}" aria-expanded="false">
          <span class="sr-only">{{ disclosure_label }}</span>
          <span class="nav-disclosure-icon" aria-hidden="true">{{- 'icon-chevron-down.svg' | inline_asset_content -}}</span>
        </button>
        </span>
        <div class="nav-dropdown nav-mega" id="{{ panel_id }}">
          <div class="bg-surface border-t border-b border-on-surface/15"{% if dropdown_color != blank %} style="background-color: {{ dropdown_color }}"{% endif %}>
            <div class="max-w-page mx-auto px-margin md:px-10 py-10 grid grid-cols-12 gap-10">
              {%- liquid
                assign leaf_count = 0
                for sub in child_links
                  assign sub_count = sub.links.size | default: 0
                  if sub_count == 0
                    assign leaf_count = leaf_count | plus: 1
                  endif
                endfor
              -%}
              {%- if menu_style != 'mega_images' -%}
                <div class="{% if menu_style == 'mega_menus' %}col-span-12{% else %}col-span-5{% endif %} flex flex-col gap-8">
                  <div class="grid grid-cols-[repeat(auto-fit,minmax(12rem,1fr))] gap-x-10 gap-y-8 content-start">
                    {%- if leaf_count > 0 -%}
                      <div class="flex flex-col gap-4">
                        <p class="text-xs font-medium uppercase tracking-[0.18em] text-on-surface-secondary">{{ link.title | escape }}</p>
                        <ul role="list" class="flex flex-col gap-2">
                          {%- for sub in child_links -%}
                            {%- assign sub_count = sub.links.size | default: 0 -%}
                            {%- if sub_count == 0 -%}
                              <li><a href="{{ sub.url }}"{% if sub.current %} aria-current="page"{% endif %} class="font-heading text-2xl leading-tight no-underline text-on-surface hover:opacity-60 aria-[current=page]:underline underline-offset-4 motion-safe:transition-opacity">{{ sub.title | escape }}</a></li>
                            {%- endif -%}
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- endif -%}
                    {%- for sub in child_links -%}
                      {%- if sub.links.size > 0 -%}
                        <div class="flex flex-col gap-4">
                          <a href="{{ sub.url }}"{% if sub.current %} aria-current="page"{% endif %} class="text-xs font-medium uppercase tracking-[0.18em] no-underline text-on-surface-secondary hover:text-on-surface motion-safe:transition-colors">{{ sub.title | escape }}</a>
                          <ul role="list" class="flex flex-col gap-2">
                            {%- for subsub in sub.links -%}
                              <li><a href="{{ subsub.url }}"{% if subsub.current %} aria-current="page"{% endif %} class="text-base no-underline text-on-surface hover:opacity-60 motion-safe:transition-opacity">{{ subsub.title | escape }}</a></li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  <a href="{{ link.url }}" class="inline-flex items-center gap-2 self-start text-xs font-medium uppercase tracking-[0.14em] no-underline text-on-surface border-b border-on-surface pb-1 hover:opacity-60 motion-safe:transition-opacity">
                    {{- 'header.view_all' | t: title: link.title -}}
                    <span class="inline-flex size-3.5 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-arrow-right.svg' | inline_asset_content -}}</span>
                  </a>
                </div>
              {%- endif -%}
              {%- if menu_style != 'mega_menus' -%}
                {%- if menu_style == 'mega_images' -%}
                  <ul role="list" class="col-span-12 grid grid-cols-[repeat(auto-fit,minmax(10rem,13rem))] justify-center gap-6">
                    {%- for sub in child_links limit: 6 -%}
                      <li>{% render 'mega-menu-tile', link: sub, aspect_ratio: 'aspect-[3/4]', sizes: '208px', seed: forloop.index %}</li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <ul role="list" class="col-span-7 grid grid-cols-3 gap-6">
                    {%- for sub in child_links limit: 3 -%}
                      <li>{% render 'mega-menu-tile', link: sub, aspect_ratio: 'aspect-[3/4]', sizes: '(min-width: 1280px) 240px, 18vw', seed: forloop.index %}</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </div>
      </s-nav-dropdown>
      {%- else -%}
      <s-nav-dropdown class="nav-has-dropdown" role="listitem">
        {%- comment -%} The link goes to the item's page; the separate button shows/hides the submenu (its aria-expanded is kept in sync by s-nav-dropdown.js). The button is only visible on keyboard focus, so mouse users still open the submenu by hovering. {%- endcomment -%}
        <a href="{{ link.url }}"
          class="{{ variant }} shrink-0 no-underline{% if text_color == blank %} text-on-surface{% endif %} hover:opacity-70 motion-safe:transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm whitespace-nowrap"
          {%- if text_color != blank %} style="color: {{ text_color }}"{% endif %}
          {%- if link.current %} aria-current="page"{% endif %}>
          {{ link.title | escape }}
        </a>
        <button type="button" class="nav-disclosure" data-nav-disclosure aria-controls="{{ panel_id }}" aria-expanded="false">
          <span class="sr-only">{{ disclosure_label }}</span>
          <span class="nav-disclosure-icon" aria-hidden="true">{{- 'icon-chevron-down.svg' | inline_asset_content -}}</span>
        </button>
        <div class="nav-dropdown" id="{{ panel_id }}">
          {%- comment -%} role="list"/role="listitem" convey the submenu hierarchy to assistive tech; the display:contents groups and leaf <li>s keep the existing grid layout. {%- endcomment -%}
          <div class="nav-dropdown-inner" role="list"{% if dropdown_color != blank %} style="background-color: {{ dropdown_color }}"{% endif %}>
            {% for sub in child_links %}
              {% if sub.links.size > 0 %}
                {%- assign sub_panel_id = panel_id | append: '-' | append: forloop.index -%}
                {%- assign sub_disclosure_title = sub.title | escape -%}
                {%- capture sub_disclosure_label -%}{{ 'header.show_submenu' | t: title: sub_disclosure_title }}{%- endcapture -%}
                <div class="nav-dropdown-group" role="listitem">
                  {%- comment -%} Split link + disclosure button so the visible title navigates while the chevron button toggles the nested column. {%- endcomment -%}
                  <div class="nav-dropdown-row">
                    <a href="{{ sub.url }}"{% if sub.current %} aria-current="page"{% endif %} class="nav-dropdown-item motion-safe:active:scale-[0.97] motion-safe:transition-transform">{{ sub.title | escape }}</a>
                    <button type="button" class="nav-dropdown-disclosure" data-nav-disclosure aria-controls="{{ sub_panel_id }}" aria-expanded="false">
                      <span class="sr-only">{{ sub_disclosure_label }}</span>
                      <span class="inline-flex items-center justify-center shrink-0 size-2.5 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
                    </button>
                  </div>
                  <div class="nav-dropdown-submenu" id="{{ sub_panel_id }}">
                    <div class="nav-submenu-inner" role="list">
                      {% for subsub in sub.links %}
                        {% if subsub.links.size > 0 %}
                          {%- assign subsub_panel_id = sub_panel_id | append: '-' | append: forloop.index -%}
                          {%- assign subsub_disclosure_title = subsub.title | escape -%}
                          {%- capture subsub_disclosure_label -%}{{ 'header.show_submenu' | t: title: subsub_disclosure_title }}{%- endcapture -%}
                          <div class="nav-dropdown-group" role="listitem">
                            <div class="nav-dropdown-row">
                              <a href="{{ subsub.url }}"{% if subsub.current %} aria-current="page"{% endif %} class="nav-dropdown-item motion-safe:active:scale-[0.97] motion-safe:transition-transform">{{ subsub.title | escape }}</a>
                              <button type="button" class="nav-dropdown-disclosure" data-nav-disclosure aria-controls="{{ subsub_panel_id }}" aria-expanded="false">
                                <span class="sr-only">{{ subsub_disclosure_label }}</span>
                                <span class="inline-flex items-center justify-center shrink-0 size-2.5 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
                              </button>
                            </div>
                            <div class="nav-dropdown-submenu" id="{{ subsub_panel_id }}">
                              <div class="nav-submenu-inner" role="list">
                                {% for subsubsub in subsub.links %}
                                  <li role="listitem" class="contents"><a href="{{ subsubsub.url }}"{% if subsubsub.current %} aria-current="page"{% endif %} class="nav-dropdown-item motion-safe:active:scale-[0.97] motion-safe:transition-transform">{{ subsubsub.title | escape }}</a></li>
                                {% endfor %}
                              </div>
                            </div>
                          </div>
                        {% else %}
                          <li role="listitem" class="contents"><a href="{{ subsub.url }}"{% if subsub.current %} aria-current="page"{% endif %} class="nav-dropdown-item motion-safe:active:scale-[0.97] motion-safe:transition-transform">{{ subsub.title | escape }}</a></li>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                </div>
              {% else %}
                <li role="listitem" class="contents"><a href="{{ sub.url }}"{% if sub.current %} aria-current="page"{% endif %} class="nav-dropdown-item motion-safe:active:scale-[0.97] motion-safe:transition-transform">{{ sub.title | escape }}</a></li>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </s-nav-dropdown>
      {%- endif -%}
    {% else %}
      <li role="listitem" class="contents">
        <a href="{{ link.url }}"
          class="{{ variant }} shrink-0 no-underline{% if text_color == blank %} text-on-surface{% endif %} hover:opacity-70 motion-safe:transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm whitespace-nowrap"
          {%- if text_color != blank %} style="color: {{ text_color }}"{% endif %}
          {%- if link.current %} aria-current="page"{% endif %}>
          {{ link.title | escape }}
        </a>
      </li>
    {% endif %}
  {% endfor %}
  </ul>
</nav>
<script type="module" src="{{ 's-nav-dropdown.js' | asset_url }}"></script>
{% endif %}

{%- comment -%} The selected menu still drives desktop and mobile; caller-owned controls need no access to that callee-local setting. {%- endcomment -%}
{% render 'mobile-nav-drawer', menu: menu, close_button: mobile_nav_close_button, localization_submit: mobile_nav_localization_submit %}

{% comment %} Menu UX requires the link list, the dropdown or mega menu style, plus top-level typography/color and dropdown surface color so merchants can tune header navigation without code. {% endcomment %}
{% schema %}
  {
    "name": "t:blocks.main_menu",
    "settings": [
      {
        "type": "link_list",
        "id": "menu",
        "label": "t:blocks.menu_settings.menu",
        "info": "t:blocks.menu_settings.menu_info",
        "default": "main-menu"
      },
      {
        "type": "select",
        "id": "menu_style",
        "label": "t:blocks.menu_settings.menu_style",
        "default": "mega_menus_images",
        "options": [
          { "value": "dropdown", "label": "t:blocks.menu_settings.menu_style_dropdown" },
          { "value": "mega_menus", "label": "t:blocks.menu_settings.menu_style_mega_menus" },
          { "value": "mega_menus_images", "label": "t:blocks.menu_settings.menu_style_mega_menus_images" },
          { "value": "mega_images", "label": "t:blocks.menu_settings.menu_style_mega_images" }
        ]
      },
      {
        "type": "text",
        "id": "mega_collection_items",
        "label": "t:blocks.menu_settings.mega_collection_items",
        "info": "t:blocks.menu_settings.mega_collection_items_info",
        "default": "Shop Mihigh, Education Center"
      },
      {
        "type": "select",
        "id": "variant",
        "label": "t:general.text_style",
        "default": "type-body",
        "options": [
          { "value": "type-display", "label": "t:variants.text_style.display" },
          { "value": "type-heading-xl", "label": "t:variants.text_style.heading_xl" },
          { "value": "type-heading-lg", "label": "t:variants.text_style.heading_lg" },
          { "value": "type-heading-md", "label": "t:variants.text_style.heading_md" },
          { "value": "type-heading-sm", "label": "t:variants.text_style.heading_sm" },
          { "value": "type-body-lg", "label": "t:variants.text_style.body_lg" },
          { "value": "type-body", "label": "t:variants.text_style.body" },
          { "value": "type-body-sm", "label": "t:variants.text_style.body_sm" },
          { "value": "type-overline", "label": "t:variants.text_style.overline" }
        ]
      },
      {
        "type": "color",
        "id": "color",
        "label": "t:general.color"
      },
      {
        "type": "color",
        "id": "dropdown_color",
        "label": "t:blocks.menu_settings.dropdown_color"
      }
    ]
  }
{% endschema %}
