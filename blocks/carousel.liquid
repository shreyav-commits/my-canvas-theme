{% doc %}
  Horizontally-scrollable carousel ("swim lane"): a scroll-snap track that shows MULTIPLE
  items at once and scrolls sideways, with optional prev/next arrows. Unlike `slideshow`
  (one slide visible at a time), a carousel reveals several items per view and is meant for
  browsing a row of cards — products, collections, blog posts, testimonials, or any mix of
  content. Compose the items in the block body; each direct child becomes one slide.

  @param {number} [columns] - Items visible per view on desktop. Default: 3.
  @param {number} [columns_mobile] - Items visible per view on mobile. Default: 1.
  @param {boolean} [show_arrows] - Render prev/next arrow buttons. Default: true.
  @param {string} [label] - Optional heading rendered above the track.
  @param {string} [heading] - Optional caller-captured heading markup (e.g. an editable text block) rendered beside the arrows; takes precedence over label.
  @param {string} [class] - Additional CSS classes appended to the root element.
  @param {string} [attributes] - Additional HTML attributes passed through to the root element.

  @category content
  @renders s-carousel

  @example
  {% block 'carousel', label: collections.frontpage.title, columns: 4 %}
    {% for product in collections.frontpage.products limit: 8 %}
      <s-view-event class="block" view-event-trigger="intersect" view-event-payload="{{ product | standard_event_data: 'view' | escape }}">
        {% block 'card', block.name: 't:shopify_library.blocks.product_card', url: product.url, aria_label: product.title, border_radius: 'rounded-card' %}
          <a href="{{ product.url | escape }}" class="relative block overflow-hidden rounded-[inherit]" aria-label="{{ product.title | escape }}">
            {% block 'image', fallback_image: product.featured_image, aspect_ratio: 'aspect-square', sizes: '(min-width: 768px) 25vw, 100vw', alt: product.title, attributes: 'loading="lazy"', seed: forloop.index %}{% endblock %}
          </a>
          {% block 'text', tag: 'h3', class: 'font-medium text-on-surface line-clamp-2' %}{{ product.title | escape }}{% endblock %}
        {% endblock %}
      </s-view-event>
    {% endfor %}
  {% endblock %}
{% enddoc %}

{%- liquid
  assign columns = columns | default: 3
  assign columns_mobile = columns_mobile | default: 1
  assign show_arrows = show_arrows | default: true, allow_false: true
  assign carousel_id = 'carousel-' | append: block.id

  assign region_label = label
  if region_label == blank
    assign region_label = 'shopify_library.carousel.label' | t
  endif
-%}

{%- comment -%} <s-carousel> wires the prev/next buttons to scroll the track by ~one page and toggles their disabled state at the ends. See assets/s-carousel.js. {%- endcomment -%}
<s-carousel
  id="{{ carousel_id }}"
  class="block relative w-full{% if class != blank %} {{ class }}{% endif %}"
  style="--carousel-columns: {{ columns }}; --carousel-columns-mobile: {{ columns_mobile }};"
  {% if attributes != blank %}{{ attributes }}{% endif %}
>
  {%- if heading != blank or label != blank or show_arrows -%}
    <div class="flex items-end justify-between gap-4 mb-8">
      {%- if heading != blank -%}
        <div class="min-w-0">{{ heading }}</div>
      {%- elsif label != blank -%}
        <h2 class="type-heading-lg text-on-surface">{{ label }}</h2>
      {%- else -%}
        <span></span>
      {%- endif -%}
      {%- if show_arrows -%}
        <div class="flex gap-2">
          <button type="button" class="button-outline inline-flex items-center justify-center size-11 rounded-button border cursor-pointer motion-safe:transition-[opacity,transform] motion-safe:active:scale-[0.93] disabled:opacity-30 disabled:pointer-events-none" data-carousel-prev aria-label="{{ 'shopify_library.carousel.previous' | t }}" aria-controls="{{ carousel_id }}-track">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="button-outline inline-flex items-center justify-center size-11 rounded-button border cursor-pointer motion-safe:transition-[opacity,transform] motion-safe:active:scale-[0.93] disabled:opacity-30 disabled:pointer-events-none" data-carousel-next aria-label="{{ 'shopify_library.carousel.next' | t }}" aria-controls="{{ carousel_id }}-track">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} Each child is sized to a fraction of the viewport so several show at once; --carousel-gap must match the `gap-4` (1rem) used on the track. {%- endcomment -%}
  <div
    id="{{ carousel_id }}-track"
    class="grid grid-flow-col auto-cols-(--carousel-item-width-mobile) sm:auto-cols-(--carousel-item-width) gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-none [&::-webkit-scrollbar]:hidden *:snap-start"
    style="--carousel-gap: 1rem; --carousel-item-width: calc((100% - (var(--carousel-columns) - 1) * var(--carousel-gap)) / var(--carousel-columns)); --carousel-item-width-mobile: calc((100% - (var(--carousel-columns-mobile) - 1) * var(--carousel-gap)) / var(--carousel-columns-mobile));"
    data-carousel-track
    tabindex="0"
    role="region"
    aria-label="{{ region_label | escape }}"
  >
    {{ content }}
  </div>
</s-carousel>

<script type="module" src="{{ 's-carousel.js' | asset_url }}"></script>

{% schema %}
  {
    "name": "t:shopify_library.blocks.carousel"
  }
{% endschema %}
