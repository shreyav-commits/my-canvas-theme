{% doc %}
  One footer link-list column. On mobile it renders as a native `<details>` accordion;
  from `md` up it renders as an always-open column. The caller composes the column
  heading (an editable text block) in the body; it renders as the accordion summary on
  mobile and as the column heading on desktop.

  @param {string} [class] - Additional classes for the root element.
  @param {string} [attributes] - Additional HTML attributes for the root element.
  @param {string} [aria_label] - Accessible name for the nav landmark. Defaults to the menu title.

  @category navigation
  @renders div

  @example
  {% block 'footer-menu-column', menu: linklists['help'] %}
    {% block 'text', tag: 'span', variant: 'type-overline' %}Help{% endblock %}
  {% endblock %}
{% enddoc %}

{%- liquid
  assign menu = menu | default: linklists.footer
  assign nav_label = aria_label | default: menu.title
  assign link_class = 'inline-flex items-center min-h-touch-target md:min-h-9 no-underline text-interactive-text/70 hover:text-interactive-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-interactive-text motion-safe:transition-colors'
-%}

{%- capture menu_links -%}
  <ul role="list" class="flex flex-col">
    {%- for link in menu.links limit: 8 -%}
      <li>
        <a href="{{ link.url }}" class="{{ link_class }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      </li>
    {%- endfor -%}
  </ul>
{%- endcapture -%}

<div class="{{ class }}"{% if attributes != blank %} {{ attributes }}{% endif %}>
  {%- comment -%} Mobile: native disclosure so it works without JS. Desktop renders the same links as an open column. {%- endcomment -%}
  <details class="group md:hidden border-b border-interactive-text/20">
    <summary class="flex items-center justify-between gap-4 min-h-14 cursor-pointer list-none [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-interactive-text">
      {{ content }}
      <span class="inline-flex size-5 shrink-0 motion-safe:transition-transform motion-safe:duration-200 group-open:rotate-180" aria-hidden="true">{{- 'icon-chevron-down.svg' | inline_asset_content -}}</span>
    </summary>
    <nav aria-label="{{ nav_label | escape }}" class="pb-4">
      {{ menu_links }}
    </nav>
  </details>

  <div class="hidden md:flex flex-col gap-4">
    {{ content }}
    <nav aria-label="{{ nav_label | escape }}">
      {{ menu_links }}
    </nav>
  </div>
</div>

{% schema %}
  {
    "name": "t:blocks.footer_menu_column",
    "settings": [
      {
        "type": "link_list",
        "id": "menu",
        "label": "t:blocks.menu_settings.menu",
        "default": "footer"
      }
    ]
  }
{% endschema %}
