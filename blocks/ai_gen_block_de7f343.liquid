{% doc %}
  @prompt
    create a journey block to store to show how to did every years like a roadmap, fix the fontsize to fit the text in block, make the text block full width instead of half, the lines are overlapped. please fix the line

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-journey-{{ ai_gen_id }} {
    padding: {{ block.settings.padding }}px 0;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-journey-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-journey-title-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    line-height: 1.2;
  }

  .ai-journey-timeline-{{ ai_gen_id }} {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
  }

  .ai-journey-timeline-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    width: {{ block.settings.line_width }}px;
    background-color: {{ block.settings.line_color }};
    top: 0;
    bottom: 0;
    left: 50%;
    margin-left: -{{ block.settings.line_width | divided_by: 2 }}px;z-index: 0;
  }

  .ai-journey-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding: 20px 60px;
    box-sizing: border-box;
    margin-bottom: 30px;
    display: flex;
    justify-content: center;
  }

  .ai-journey-item-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    background-color: {{ block.settings.dot_color }};
    border-radius: 50%;
    top: 30px;
    left: 50%;
    margin-left: -{{ block.settings.dot_size | divided_by: 2 }}px;
    z-index: 1;
  }

  .ai-journey-content-{{ ai_gen_id }} {
    padding: 20px;
    background-color: {{ block.settings.item_background }};
    border-radius: {{ block.settings.item_border_radius }}px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    word-wrap: break-word;
    overflow-wrap: break-word;
    width: 100%;
    max-width: 800px;
    text-align: center;position: relative;
    z-index: 2;
  }

  .ai-journey-year-{{ ai_gen_id }} {
    font-size: {{ block.settings.year_size }}px;
    font-weight: bold;
    color: {{ block.settings.year_color }};
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .ai-journey-milestone-{{ ai_gen_id }} {
    font-size: {{ block.settings.milestone_size }}px;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .ai-journey-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
  }

  .ai-journey-image-{{ ai_gen_id }} {
    width: 100%;
    max-width: 500px;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin: 15px auto 0;
    display: block;
  }
  
  .ai-journey-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 16/9;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 15px auto 0;
  }
  
  .ai-journey-image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.5;
  }

  @media screen and (max-width: 767px) {
    .ai-journey-timeline-{{ ai_gen_id }}::before {
      left: {{ block.settings.dot_size | divided_by: 2 | plus: 10 }}px;margin-left: 0;
    }

    .ai-journey-item-{{ ai_gen_id }} {
      padding-left: {{ block.settings.dot_size | plus: 30 }}px;
      padding-right: 10px;
      justify-content: flex-start;
    }

    .ai-journey-item-{{ ai_gen_id }}::after {
      left: {{ block.settings.dot_size | divided_by: 2 | plus: 10 }}px;
      margin-left: 0;
    }

    .ai-journey-content-{{ ai_gen_id }} {
      text-align: left;
    }
    
    .ai-journey-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
    .ai-journey-year-{{ ai_gen_id }} {
      font-size: {{ block.settings.year_size | times: 0.9 }}px;
    }
    
    .ai-journey-milestone-{{ ai_gen_id }} {
      font-size: {{ block.settings.milestone_size | times: 0.9 }}px;
    }
    
    .ai-journey-image-{{ ai_gen_id }},
    .ai-journey-image-placeholder-{{ ai_gen_id }} {
      margin-left: 0;
    }
  }
  
  @media screen and (max-width: 480px) {
    .ai-journey-content-{{ ai_gen_id }} {
      padding: 15px;
    }
    
    .ai-journey-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }
    
    .ai-journey-year-{{ ai_gen_id }} {
      font-size: {{ block.settings.year_size | times: 0.8 }}px;
    }
    
    .ai-journey-milestone-{{ ai_gen_id }} {
      font-size: {{ block.settings.milestone_size | times: 0.8 }}px;
    }
    
    .ai-journey-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-journey-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-journey-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-journey-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-journey-timeline-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% assign year_key = 'year_' | append: i %}
        {% assign milestone_key = 'milestone_' | append: i %}
        {% assign description_key = 'description_' | append: i %}
        {% assign image_key = 'image_' | append: i %}
        
        {% assign year = block.settings[year_key] %}
        {% assign milestone = block.settings[milestone_key] %}
        {% assign description = block.settings[description_key] %}
        {% assign image = block.settings[image_key] %}
        
        {% if year != blank and milestone != blank %}
          <div class="ai-journey-item-{{ ai_gen_id }}">
            <div class="ai-journey-content-{{ ai_gen_id }}">
              <div class="ai-journey-year-{{ ai_gen_id }}">{{ year }}</div>
              <div class="ai-journey-milestone-{{ ai_gen_id }}">{{ milestone }}</div>
              {% if description != blank %}
                <div class="ai-journey-description-{{ ai_gen_id }}">{{ description }}</div>
              {% endif %}
              {% if image != blank %}
                <img
                  src="{{ image | img_url: '600x' }}"
                  alt="{{ milestone }}"
                  loading="lazy"
                  class="ai-journey-image-{{ ai_gen_id }}"
                >
              {% elsif block.settings.show_placeholders %}
                <div class="ai-journey-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

