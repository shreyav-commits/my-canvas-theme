<!-- {{ block.settings.block_title }} -->
<!-- @data/split -->
<div class="mega-menu section section--full-width-margin section--{{ section.settings.section_width }}">
  <div
    class="mega-menu__grid"
    data-menu-grid-id="{{ block.id }}"
  >
    <span
      class="mega-menu__content"
      style="--menu-content-columns-desktop: 4; --menu-content-columns-tablet: 3; --resource-card-corner-radius: 0px;"
    >
      <ul
        class="mega-menu__content-list mega-menu__content-list--collections list-unstyled"
        style="--menu-content-columns-desktop: 4; --menu-content-columns-tablet: 3;"
      >
        {%- for i in (1..4) -%}
          {% capture image %}image_{{ i }}{% endcapture %}
          {% capture url %}url_{{ i }}{% endcapture %}
          {% capture text %}text_{{ i }}{% endcapture %}
          {% if block.settings[image] != blank and block.settings[text] != blank %}
            <li class="mega-menu__content-list-item{% if forloop.index > 3 %} mega-menu__content-list-item--hidden-tablet{% endif %}">
              <div class="">
                <a href="{{ block.settings[url] }}">
                  <div class="">
                    <img src="{{ block.settings[image] | img_url: 'master' }}" alt="{{ block.settings[text] }}">
                  </div>
                  <span>{{ block.settings[text] }}</span>
                </a>
              </div>
            </li>
          {% endif %}
        {%- endfor -%}
      </ul>
    </span>
  </div>
</div>
<!-- @enddata/split -->

