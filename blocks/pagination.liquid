{% doc %}
  Renders accessible pagination controls using Shopify's paginate object.

  One numbered treatment is shared by every paginated template so storefront and
  Canvas presentation stay consistent. The active page uses the theme's
  interactive tokens; there is no per-block color override. The `pagination_style`
  setting switches a usage between numbered pages and infinite scroll.

  @param {object} paginate - Shopify paginate object; provided by a `paginate` tag in the calling template. @required
  @param {string} [class] - Additional classes to apply to the nav element.
  @param {string} [attributes] - Additional HTML attributes passed through to the root element.
  @param {string} [prev] - HTML content to replace the default left-arrow icon inside the previous button wrapper.
  @param {string} [next] - HTML content to replace the default right-arrow icon inside the next button wrapper.
  @param {string} [target] - CSS selector of the list that infinite scroll appends into. Default: '#product-grid'.
  @param {string} [summary] - HTML content rendered before the `<nav>` element (e.g. "Showing 1–24 of 96 results").

  @category layout
  @renders nav[aria-label=Pagination]
  @context paginate

  @example
  {% paginate collection.products by 24 %}
    {% for product in collection.products %}
      ...
    {% endfor %}
    {% block 'pagination', paginate: paginate %}{% endblock %}
  {% endpaginate %}
{% enddoc %}

{%- liquid
  assign class_append = ''
  if class != blank
    assign class_append = ' ' | append: class
  endif
-%}

{%- if paginate != blank and paginate.pages > 1 and pagination_style == 'infinite' -%}
  {%- comment -%} Infinite scroll: appends the next page's items into `target` as the shopper nears the end. The link is the no-JS and manual fallback. {%- endcomment -%}
  {%- if paginate.next -%}
    <s-infinite-scroll
      class="flex flex-col items-center gap-3 py-8{{ class_append }}"
      data-target="{{ target | default: '#product-grid' | escape }}"
      data-next-url="{{ paginate.next.url }}"
      data-loading-label="{{ 'general.pagination.loading' | t | escape }}"
      data-loaded-message="{{ 'general.pagination.loaded' | t | escape }}"
      {%- if attributes != blank %} {{ attributes }}{% endif %}
    >
      <a
        href="{{ paginate.next.url }}"
        data-load-more
        class="inline-flex items-center justify-center h-12 px-8 border border-on-surface text-xs font-medium uppercase tracking-[0.14em] text-on-surface no-underline hover:bg-interactive hover:text-interactive-text aria-busy:opacity-60 aria-busy:pointer-events-none motion-safe:transition-[color,background-color,opacity,transform] motion-safe:active:scale-[0.97]"
      >
        {{- 'general.pagination.load_more' | t -}}
      </a>
      <p class="sr-only" role="status" data-status></p>
    </s-infinite-scroll>
    <script type="module" src="{{ 's-infinite-scroll.js' | asset_url }}"></script>
  {%- endif -%}
{%- elsif paginate != blank and paginate.pages > 1 -%}
  {%- if summary != blank -%}
    {{ summary }}
  {%- endif -%}

  <nav aria-label="{{ 'general.pagination.label' | t }}" class="flex items-center justify-center gap-1{{ class_append }}"{% if attributes != blank %} {{ attributes }}{% endif %}>
    {%- if paginate.previous -%}
      <a
        href="{{ paginate.previous.url }}"
        class="inline-flex items-center justify-center min-w-touch-target min-h-touch-target rounded text-sm hover:bg-surface-secondary motion-safe:transition-[color,background-color,transform] motion-safe:duration-150 motion-safe:active:scale-[0.95]"
        aria-label="{{ 'general.pagination.previous_page' | t }}"
      >
        {%- if prev != blank -%}
          {{ prev }}
        {%- else -%}
          <span class="inline-flex items-center justify-center shrink-0 size-3.5 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
        {%- endif -%}
      </a>
    {%- else -%}
      <span class="inline-flex items-center justify-center min-w-touch-target min-h-touch-target rounded text-sm text-on-surface-secondary opacity-40 cursor-not-allowed" role="link" aria-disabled="true" aria-label="{{ 'general.pagination.previous_page' | t }}">
        {%- if prev != blank -%}
          {{ prev }}
        {%- else -%}
          <span class="inline-flex items-center justify-center shrink-0 size-3.5 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
        {%- endif -%}
      </span>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a
          href="{{ part.url }}"
          class="inline-flex items-center justify-center min-w-touch-target min-h-touch-target rounded text-sm hover:bg-surface-secondary motion-safe:transition-[color,background-color,transform] motion-safe:duration-150 motion-safe:active:scale-[0.95]"
          aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
        >
          {{- part.title -}}
        </a>
      {%- elsif part.title == '&hellip;' or part.title == '…' -%}
        <span class="min-w-touch-target min-h-touch-target inline-flex items-center justify-center text-on-surface-secondary" aria-hidden="true">
          &hellip;
        </span>
      {%- else -%}
        <span
          aria-current="page"
          class="inline-flex items-center justify-center min-w-touch-target min-h-touch-target rounded text-sm bg-interactive text-interactive-text font-medium"
        >
          <span class="sr-only">{{ 'general.pagination.current_page' | t: number: part.title }}</span>
          <span aria-hidden="true">{{- part.title -}}</span>
        </span>
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a
        href="{{ paginate.next.url }}"
        class="inline-flex items-center justify-center min-w-touch-target min-h-touch-target rounded text-sm hover:bg-surface-secondary motion-safe:transition-[color,background-color,transform] motion-safe:duration-150 motion-safe:active:scale-[0.95]"
        aria-label="{{ 'general.pagination.next_page' | t }}"
      >
        {%- if next != blank -%}
          {{ next }}
        {%- else -%}
          <span class="inline-flex items-center justify-center shrink-0 size-3.5 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
        {%- endif -%}
      </a>
    {%- else -%}
      <span class="inline-flex items-center justify-center min-w-touch-target min-h-touch-target rounded text-sm text-on-surface-secondary opacity-40 cursor-not-allowed" role="link" aria-disabled="true" aria-label="{{ 'general.pagination.next_page' | t }}">
        {%- if next != blank -%}
          {{ next }}
        {%- else -%}
          <span class="inline-flex items-center justify-center shrink-0 size-3.5 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
        {%- endif -%}
      </span>
    {%- endif -%}
  </nav>
{%- endif -%}

{% schema %}
  {
    "name": "t:blocks.pagination",
    "settings": [
      {
        "type": "select",
        "id": "pagination_style",
        "label": "t:blocks.pagination_style",
        "default": "numbered",
        "options": [
          { "value": "numbered", "label": "t:blocks.pagination_numbered" },
          { "value": "infinite", "label": "t:blocks.pagination_infinite" }
        ]
      }
    ]
  }
{% endschema %}
